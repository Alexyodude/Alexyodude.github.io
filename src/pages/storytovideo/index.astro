---
import '../../styles/global.css';
import BackgroundStars from '../../components/BackgroundStars.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>StoryToVideo — alexyodude.com</title>
    <meta name="description" content="StoryToVideo, a personal tool that turns stories into short videos for Alex's own channels." />
    <!-- Dark only — see index.astro. -->
    <script is:inline>
      document.documentElement.setAttribute('data-theme', 'dark');
    </script>
  </head>
  <body>
    <BackgroundStars />
    <NavBar />
    <main>
      <section class="px-6 py-16 max-w-3xl mx-auto space-y-5">
        <a href="/" class="text-sm text-muted underline decoration-muted underline-offset-4 hover:text-accent hover:decoration-accent">← Home</a>
        <h1 class="mt-6 text-4xl md:text-5xl font-bold tracking-tight">StoryToVideo</h1>
        <p>
          StoryToVideo is a personal tool made by Alex. It turns short stories into vertical
          videos and posts them to Alex's own YouTube channel and to Alex's own TikTok and
          Instagram accounts.
        </p>
        <p>
          It is not offered to anyone else: there are no user accounts, and the only Google
          account it ever signs in to is Alex's own.
        </p>
        <p>
          <a href="/storytovideo/privacy" class="underline underline-offset-4 hover:text-accent">Privacy policy</a>
          ·
          <a href="/storytovideo/terms" class="underline underline-offset-4 hover:text-accent">Terms of service</a>
        </p>
        <p class="text-muted">Contact: thisisconnection720@gmail.com</p>
      </section>
    </main>
    <Footer />
  </body>
</html>
