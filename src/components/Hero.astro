---
const bio = 'Physical theory is our limitation.';
const socials = [
  { label: 'GitHub',   href: 'https://github.com/Alexyodude',           icon: '/icons/github.svg' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/alexyodude/', icon: '/icons/linkedin.svg' },
  { label: 'X',        href: 'https://x.com/MrPorkchop720',             icon: '/icons/x.svg' },
  { label: 'YouTube',  href: 'https://www.youtube.com/@MrPorkchop7200', icon: '/icons/youtube.svg' },
  { label: 'Email',    href: 'mailto:alex@mutual.solutions',            icon: '/icons/email.svg' },
];
---

<section class="px-6 py-24 md:py-32 max-w-3xl mx-auto">
  <h1 class="text-5xl md:text-7xl font-bold tracking-tight">
    Jihoon Park <span lang="ko">박지훈</span> <span class="text-muted font-normal">(Alex)</span>
  </h1>
  <p class="mt-6 text-xl md:text-2xl text-muted">{bio}</p>
  <ul class="mt-8 flex flex-wrap items-center gap-4">
    {socials.map((s) => (
      <li>
        <a
          href={s.href}
          aria-label={s.label}
          title={s.label}
          class="flex h-11 w-11 items-center justify-center rounded-full border border-border text-muted hover:text-accent hover:border-accent transition-colors"
        >
          <span class="social-icon" style={`--icon: url('${s.icon}');`} aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .social-icon {
    display: inline-block;
    width: 22px;
    height: 22px;
    background-color: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }
</style>
