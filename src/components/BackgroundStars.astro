    // Realtime-timeline bookkeeping (see logEvent / drawEventTimeline).
    let lastNoTargetLog = -Infinity;
    let lastTransitDist = Infinity;
    let lastTransitApproaching = true;
    let autopilotBrakeLogged = false;
    let lastKeyLog = -Infinity;
    const lastVelDir = [0, 0, 1];
    let lastVelDirMag = 0;
    // ===== view turn dynamics =====
    // Not an exponential ease. Exponential decay is FASTEST at the start, so a
    // big turn lurches away and then crawls — the opposite of how a real
    // camera moves. This is an acceleration-limited angular slew instead:
    // angular speed ramps up under an accel cap (ease-in), holds a ceiling,
    // then eases out as the remaining angle shrinks. Small tracking
    // corrections are unaffected — their desired speed is tiny from the start.
    const VIEW_TURN_SETTLE_S = 1.1;   // arrival easing: desired ≈ angle / this
    // Ease-in is LOGARITHMIC: the angular rate grows by a fixed proportion per
    // second (doublings/s), not a fixed increment (deg/s²). Two reasons.
    // Consistency — velocity already slews in decades/s and the transit brake
    // is exponential in distance, so a linear ramp was the odd one out. And
    // perception — apparent rate-of-change is proportional, so a constant
    // fractional increase reads as uniform acceleration where a linear ramp
    // reads as sluggish-then-sudden. Exponential growth cannot start from
    // zero, hence the seed floor.
    const VIEW_TURN_ACCEL_OCT_S = 2.6;  // doublings of angular rate per second
    const VIEW_TURN_SEED_DPS = 1.5;     // growth floor, deg/s
    // The hidden flip spools up faster — it has further to climb (75 vs 32
    // deg/s ceiling) and no viewer, so a leisurely ramp would only lengthen
    // the blind hover inside the star.
    const VIEW_FLIP_ACCEL_OCT_S = 4.2;
    // Speed multiplier when the view points away from travel (0 = full stop
    // until aligned, 1 = no gating). Applies through the whole forward turn.
    const VIEW_MISALIGN_SPEED_FLOOR = 0.12;
    // How fast the speed cap decays toward arrival speed while the view is
    // turning, in halvings per second. Higher = the ship sheds speed sooner
    // so more of the turn happens at low β.
    const VEL_TURN_SLOWDOWN_OCT_S = 1.6;
    // Ceiling for the VISIBLE turn (look-back → forward at handoff). Low on
    // purpose: this is the one the viewer actually watches, ~6s for 180°.
    const VIEW_TURN_MAX_DPS = 17;
    // Ceiling for the look-back flip. That one happens inside the star where
    // the interior wash hides the sky, and the ship hovers until it finishes,
    // so a slow flip would only stretch the hover with nothing to show.
    const VIEW_FLIP_MAX_DPS = 75;
    let viewAngVel = 0;               // current angular speed, rad/s
    // Derived from viewDir once per frame, purely so the debug panel and the
    // deep-state dump have something meaningful to report.
    let yaw = 0;
    let pitch = 0;
    let drifting = true;
    let lastCamV = 0; // last frame's instantaneous speed (m/s), used by UI
    let smoothBeta = 0; // β smoothed across frames — gives a gradual ramp on Shift warp
    const velocity = [0, 0, 0]; // current world-space velocity (m/s); smoothed toward target for inertia
    let autoW = true; // virtual W held by default until the user presses W themselves
    let autopilot = true; // enabled by default — POI tour kicks off immediately
    let autopilotTarget = null;
    let nextAutopilotTarget = null; // pre-acquired during linger for smooth handoff
    let autopilotPhase = 'searching'; // 'traveling' | 'lingering' | 'searching'
    let autopilotLingerStart = 0;
    let autopilotTravelStart = 0; // wall-clock sec when current travel began (for max-rotate-time cap)
    let autopilotOrigDist = 0;    // dist to current target at travel start (used by debug curve marker)
    let autopilotBrakeStart = -1; // wall-clock sec when camera first crossed into the brake corridor (-1 = not braking yet)
    let autopilotStartVel = 0;    // |v| at travel start — ramp begins from here so trips smoothly connect to the previous arrival
    let autopilotPeakVel = 0;     // peak velocity for this trip (time-based bell curve top)
    let autopilotCruiseTime = 0;  // seconds spent at peakVel between accel ramp and decel brake
    let autopilotFinalStart = -1; // wall-clock sec when curveVel first dropped below finalApproachVelC (-1 = not yet)
    let autopilotFinalEntryVel = 0; // velocity at the moment final approach engaged (used as ramp top)
    const autopilotVelHistory = []; // [{t, v}] samples since travel start, drawn as the actual-velocity overlay on the debug curve
    const VEL_HISTORY_LIMIT = 1024;
    let autopilotExpectedAccel = 0;    // sec spent in accel band (constant: accelTimeSec)
    let autopilotExpectedCruise = 0;   // sec spent cruising at maxW
    let autopilotExpectedDecel = 0;    // sec spent decelerating across corridor
    let autopilotExpectedDuration = 1; // sum — used as the timeline x-axis length
    function recomputeTripEstimate() {
      if (!autopilotTarget) { autopilotExpectedDuration = 1; return; }
      const aRad = autopilotTarget.physRadius || 1e9;
      const aMul = autoApproachFor(autopilotTarget.type);
      const cThr = aRad * aMul;
      const offset = Math.max(0.05, Math.min(1, autoCfg.warpCurveOffset || 1));
      const maxW = Math.pow(10, autoCfg.maxWarpExp) * offset;
      const designSp = cThr / Math.max(0.1, (autoCfg.linger * autoCfg.designSpeedDivisor));
      const aT = Math.max(0.05, autoCfg.accelTimeSec);
      const aPow = Math.max(1, autoCfg.accelPower);
      const mirror = (autoCfg.decelMirrorAccel || 0) >= 0.5;
      const dT = Math.max(0.05, mirror ? aT : (autoCfg.decelTimeSec || 0.6));
      const dPow = Math.max(0.2, mirror ? aPow : autoCfg.decelPower);
      const cruiseHold = Math.max(0, autoCfg.cruiseMinSec || 0);
      const decelDelay = Math.max(0, autoCfg.decelOffsetSec || 0);
      const startV = autopilotStartVel || 0;
      const finalSec = Math.max(0, autoCfg.finalApproachSec || 0);
      // Do NOT subtract finalDist from D — for short trips that drives D≤0
      // and clamps peak at designSpeed, locking the whole trip at 8e7 m/s.
      // The final-approach phase naturally cuts short when the linger trigger
      // fires (dist < closeThreshold), so no pre-reservation is needed.
      const D = Math.max(0, autopilotOrigDist - cThr);
      // Closed-form solve.
      //   accelDist  = aT · (startV + (peak − startV) / (aPow + 1))
      //   cruiseDist = peak · cruiseTime
      //   decelDist  = dT · (designSp + (peak − designSp) / (dPow + 1))
      //   D = accelDist + cruiseDist + decelDist
      // Given a random target total time T = aT + cruiseTime + dT, solve for
      // peak. Then cap at maxW (or designSp floor) if the random target is
      // infeasible for this origDist.
      const ca = aT * startV * aPow / (aPow + 1);
      const cd = dT * designSp * dPow / (dPow + 1);
      const T = Math.max(aT + dT + 0.05, autopilotTripTargetSec || 5);
      const cruiseTimeReq = Math.max(0, T - aT - dT);
      const k = aT / (aPow + 1) + cruiseTimeReq + dT / (dPow + 1);
      let peak = (D - ca - cd) / Math.max(k, 1e-9);
      let cruiseTime;
      if (peak > maxW) {
        // Asked-for time is too short for this distance — cap at maxW and
        // grow cruise to absorb the surplus.
        peak = maxW;
        const accelAtMax = aT * (startV + (maxW - startV) / (aPow + 1));
        const decelAtMax = dT * (designSp + (maxW - designSp) / (dPow + 1));
        const surplus = D - accelAtMax - decelAtMax;
        if (surplus >= 0) {
          cruiseTime = surplus / Math.max(maxW, 1);
        } else {
          // Even with cruise=0, accel + decel at maxW overshoots the trip
          // distance budget. Solve for the lower peak that exactly fits:
          //   aT·(startV + (p − startV)/(aPow+1))
          // + dT·(designSp + (p − designSp)/(dPow+1)) = D
          //   ⇒ p · [aT/(aPow+1) + dT/(dPow+1)] = D − aT·startV·aPow/(aPow+1) − dT·designSp·dPow/(dPow+1)
          const k2 = aT / (aPow + 1) + dT / (dPow + 1);
          peak = Math.max(designSp, (D - ca - cd) / Math.max(k2, 1e-9));
          cruiseTime = 0;
        }
      } else if (peak < designSp) {
        // Asked-for time is too long for this distance — short trip, no cruise.
        peak = Math.max(designSp, peak);
        cruiseTime = 0;
      } else {
        cruiseTime = cruiseTimeReq;
      }
