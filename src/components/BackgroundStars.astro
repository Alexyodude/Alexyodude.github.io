      if (!evtCanvas || !evtCtx) return;
      const dprL = Math.min(window.devicePixelRatio || 1, 2);
      const cw = Math.max(240, Math.round(evtCanvas.clientWidth || 520));
      const ch = Math.max(90, Math.round(evtCanvas.clientHeight || 150));
      if (cw === evtW && ch === evtH && evtCanvas.width === Math.round(cw * dprL)) return;
      evtW = cw; evtH = ch;
      evtCanvas.width = Math.round(cw * dprL);
      evtCanvas.height = Math.round(ch * dprL);
      evtCtx.setTransform(dprL, 0, 0, dprL, 0, 0);
    }
    if (evtCanvas && typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(() => sizeEvtCanvas()).observe(evtCanvas);
    }

    function drawEventTimeline() {
      if (!evtCtx || !tourSamples.length) return;
      sizeEvtCanvas();
      const W2 = evtW, H2 = evtH;
      const now = performance.now() / 1000;
      const tMin = now - EVT_WINDOW;
      const LOGMIN = 6, LOGMAX = 13;         // 1e6 .. 1e13 m/s
      const xOf = (t) => ((t - tMin) / EVT_WINDOW) * W2;
      const yOf = (v) => {
        const l = Math.log10(Math.max(1, v));
        return H2 - 12 - ((Math.min(LOGMAX, Math.max(LOGMIN, l)) - LOGMIN) / (LOGMAX - LOGMIN)) * (H2 - 26);
      };
      evtCtx.clearRect(0, 0, W2, H2);
      evtCtx.fillStyle = 'rgba(10,12,16,0.9)';
      evtCtx.fillRect(0, 0, W2, H2);
      // c reference line
      evtCtx.strokeStyle = '#3a3f4a'; evtCtx.setLineDash([3, 3]);
      evtCtx.beginPath(); evtCtx.moveTo(0, yOf(299792458)); evtCtx.lineTo(W2, yOf(299792458)); evtCtx.stroke();
      evtCtx.setLineDash([]);
      evtCtx.fillStyle = '#5a6070'; evtCtx.font = '8px monospace';
      evtCtx.fillText('c', 3, yOf(299792458) - 2);
      // velocity trace
      evtCtx.strokeStyle = '#5bc8ff'; evtCtx.lineWidth = 1.2;
      evtCtx.beginPath();
      let started = false;
      for (const [t, v] of tourSamples) {
        const x = xOf(t);
        if (x < 0) continue;
        const y = yOf(v);
        if (!started) { evtCtx.moveTo(x, y); started = true; } else evtCtx.lineTo(x, y);
      }
      evtCtx.stroke();
      evtCtx.lineWidth = 1;
      // events: tick + label. Collision-aware placement: each label takes the
      // first of 6 rows whose right edge it clears, so clustered events stack
      // vertically instead of overprinting each other.
      const ROWS = 6;
      const rowRight = new Array(ROWS).fill(-Infinity);
      for (const e of tourEvents) {
        if (e.t < tMin) continue;
        const x = xOf(e.t);
        const col = EVT_COLORS[e.cls] || '#aaa';
        evtCtx.strokeStyle = col; evtCtx.globalAlpha = 0.55;
        evtCtx.beginPath(); evtCtx.moveTo(x, 8); evtCtx.lineTo(x, H2 - 12); evtCtx.stroke();
        evtCtx.globalAlpha = 1;
        const label = e.label.slice(0, 26);
        const w = evtCtx.measureText(label).width;
        let r = 0;
        while (r < ROWS - 1 && rowRight[r] > x - 3) r++;
        const lx = Math.min(Math.max(x + 2, 1), W2 - w - 2);
        rowRight[r] = lx + w + 6;
        evtCtx.fillStyle = col;
        evtCtx.fillText(label, lx, 15 + r * 9);
      }
      // time axis
      evtCtx.fillStyle = '#5a6070';
      evtCtx.fillText('-' + EVT_WINDOW + 's', 2, H2 - 3);
      evtCtx.fillText('now', W2 - 22, H2 - 3);
    }

    function setDebugOpen(open) {
      if (!debugPanel) return;
      debugPanel.classList.toggle('hidden', !open);
      debugPanel.setAttribute('aria-hidden', open ? 'false' : 'true');
      if (debugPlotPanel) {
        debugPlotPanel.classList.toggle('hidden', !open);
        debugPlotPanel.setAttribute('aria-hidden', open ? 'false' : 'true');
      }
      if (open) drawDecelCurve();
    }
    if (btnDebug) btnDebug.addEventListener('click', () => setDebugOpen(debugPanel.classList.contains('hidden')));
    if (btnDebugClose) btnDebugClose.addEventListener('click', () => setDebugOpen(false));
    if (btnDebugReset) btnDebugReset.addEventListener('click', () => {
      Object.assign(autoCfg, JSON.parse(JSON.stringify(debugDefaults)));
      buildDebugRows();
      recomputeTripEstimate();
      drawDecelCurve();
    });
    if (btnDebugNextPoi) btnDebugNextPoi.addEventListener('click', () => {
      autopilotForceRefresh = true;
    });
    if (btnDebugCopy) btnDebugCopy.addEventListener('click', async () => {
      const snippet = 'const autoCfg = ' + JSON.stringify(autoCfg, null, 2)
        .replace(/"([a-zA-Z_]+)":/g, '$1:')
        .replace(/\n/g, '\n      ')
        + ';';
      try {
        await navigator.clipboard.writeText(snippet);
        btnDebugCopy.textContent = 'Copied!';
        setTimeout(() => { btnDebugCopy.textContent = 'Copy config'; }, 1400);
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = snippet;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); btnDebugCopy.textContent = 'Copied!'; }
        catch (_) { btnDebugCopy.textContent = 'Copy failed'; }
        document.body.removeChild(ta);
        setTimeout(() => { btnDebugCopy.textContent = 'Copy config'; }, 1400);
      }
    });
    buildDebugRows();

    document.querySelectorAll('.coord-speed').forEach((b) => {
      b.addEventListener('click', () => {
        const m = parseFloat(b.dataset.mul) || 1;
        TIME_MUL = m;
        document.querySelectorAll('.coord-speed').forEach((x) => x.classList.toggle('coord-speed-active', x === b));
      });
    });
    // Mark default active (1 year/sec)
    const defaultSpeed = document.querySelector('.coord-speed[data-mul="' + TIME_DEFAULT + '"]');
    if (defaultSpeed) defaultSpeed.classList.add('coord-speed-active');

    // ===== WASD/QE navigation =====
    const keys = new Set();
    function isTypingTarget(t) {
      return t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
    }
    window.addEventListener('keydown', (e) => {
      if (isTypingTarget(e.target)) return;
      const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      if (k === 'w') autoW = false; // user takes over the virtual auto-press
      keys.add(k);
      if (['w','a','s','d','q','e'].includes(k) && tAnimAccum - lastKeyLog > 1.5) {
        lastKeyLog = tAnimAccum;
        logEvent('manual key: ' + k.toUpperCase(), 'user');
      }
      if (k === ' ' || (['w','a','s','d','q','e'].includes(k))) e.preventDefault();
    }, { passive: false });
    window.addEventListener('keyup', (e) => {
      const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      keys.delete(k);
    });
    window.addEventListener('blur', () => keys.clear());

    // Right-click drag rotation removed. The view turns only to follow the
    // direction of travel; nothing aims it independently of motion.

    // ===== Touch: two-finger gestures (single-finger left alone for page scroll) =====
    // Pinch in/out → move backward/forward. Two-finger pan does nothing: the
    // camera orientation is fixed, so there is no yaw/pitch to drive.
    let touchActive = false;
    let lastT1x = 0, lastT1y = 0, lastT2x = 0, lastT2y = 0, lastTDist = 0;
    function touchInPanel(e) {
      const t = e.target;
      return t && t.closest && t.closest('#coord-panel');
    }
    document.addEventListener('touchstart', (e) => {
      if (e.touches.length < 2) { touchActive = false; return; }
      if (touchInPanel(e)) return;
      touchActive = true;
      lastT1x = e.touches[0].clientX; lastT1y = e.touches[0].clientY;
      lastT2x = e.touches[1].clientX; lastT2y = e.touches[1].clientY;
      lastTDist = Math.hypot(lastT1x - lastT2x, lastT1y - lastT2y);
      e.preventDefault();
    }, { passive: false });
    document.addEventListener('touchmove', (e) => {
      if (!touchActive) return;
      if (e.touches.length < 2) { touchActive = false; return; }
      const t1x = e.touches[0].clientX, t1y = e.touches[0].clientY;
      const t2x = e.touches[1].clientX, t2y = e.touches[1].clientY;
      // Pinch: distance change → forward/back thrust along camera forward
      const dist = Math.hypot(t1x - t2x, t1y - t2y);
      const pinchDelta = dist - lastTDist;
      if (Math.abs(pinchDelta) > 0.5) {
        // Map pixel pinch to a meaningful world-space velocity scale.
        // Tied to a fraction of nearest object's radius so it's usable near anything.
        const refScale = Math.max(1e9, Math.min(1e15, lastNearestR * 0.5 || 1e10));
        const push = pinchDelta * refScale * 0.04;
        cam[0] += fx * push; cam[1] += fy * push; cam[2] += fz * push;
      }
      lastT1x = t1x; lastT1y = t1y; lastT2x = t2x; lastT2y = t2y; lastTDist = dist;
      e.preventDefault();
    }, { passive: false });
    document.addEventListener('touchend', (e) => {
      if (e.touches.length < 2) touchActive = false;
    });
    document.addEventListener('touchcancel', () => { touchActive = false; });
    // The native context menu is left alone: right-click no longer drives
    // camera rotation, so there is nothing to suppress it for.

    // ===== Visit nearest object of a given type =====
    function findNearest(type, searchRadius) {
      const ccx = Math.floor(cam[0] / CHUNK_SIZE);
      const ccy = Math.floor(cam[1] / CHUNK_SIZE);
      const ccz = Math.floor(cam[2] / CHUNK_SIZE);
      let best = null, bestD2 = Infinity;
      for (let dx = -searchRadius; dx <= searchRadius; dx++) {
        for (let dy = -searchRadius; dy <= searchRadius; dy++) {
          for (let dz = -searchRadius; dz <= searchRadius; dz++) {
            const objs = getChunk(ccx + dx, ccy + dy, ccz + dz);
            for (const obj of objs) {
              // Scenery stars are not destinations — "visit star" should land
              // on a real one with a generated surface, not a background dot.
              if (obj.type !== type || obj.bg) continue;
              const ddx = obj.wx - cam[0];
              const ddy = obj.wy - cam[1];
              const ddz = obj.wz - cam[2];
              const d2 = ddx * ddx + ddy * ddy + ddz * ddz;
              if (d2 < bestD2) { bestD2 = d2; best = obj; }
            }
          }
        }
      }
      return best;
    }
    // Approach multipliers (how many object-radii away to land).
    // Bigger objects (BHs, nebulae) need wider margin to look good on screen.
    const APPROACH_MUL = { planet: 5, star: 30, nebula: 2.5, blackhole: 80 };
    // Some types are very rare — expand search radius accordingly.
    const SEARCH_RADIUS = { planet: 8, star: 6, nebula: 15, blackhole: 30 };

    // ===== Autopilot helpers =====
    function poiKey(obj) {
      return obj.wx.toExponential(3) + '|' + obj.wy.toExponential(3) + '|' + obj.wz.toExponential(3);
    }
    function findNextAutopilotPOI() {
      const ccx = Math.floor(cam[0] / CHUNK_SIZE);
      const ccy = Math.floor(cam[1] / CHUNK_SIZE);
      const ccz = Math.floor(cam[2] / CHUNK_SIZE);
      // Reference direction for the forward cone is TRAVEL, not gaze. The two
      // normally agree (the view follows the heading), but they diverge for
      // seconds at a time — during the transit look-back, and throughout the
      // slow turn back to forward. Searching along a lagging gaze would pick
      // targets behind the ship. Gaze is only the fallback when stopped, where
      // velocity has no meaningful direction.
      const vm2 = Math.sqrt(velocity[0]*velocity[0] + velocity[1]*velocity[1] + velocity[2]*velocity[2]);
      const refX = vm2 > 1 ? velocity[0]/vm2 : viewDir[0];
      const refY = vm2 > 1 ? velocity[1]/vm2 : viewDir[1];
      const refZ = vm2 > 1 ? velocity[2]/vm2 : viewDir[2];
      const haveDir = true;
      // Score candidates by ANGLE primarily (minimal angle change wins),
      // distance secondary. Hard reject if angle > autoCfg.maxAngleChange.
      // First pass enforces the angle cap; only if nothing qualifies do we
      // fall back to accepting any forward candidate.
      // Skip targets too close for a meaningful warp leg — but keep the floor
      // small so sparse regions still resolve a target instead of falling back
      // to plain drift. 1e10 m (≈ 100,000 km) is well above any body radius
      // but tiny compared to typical inter-chunk spacing.
      const MIN_TRIP_DIST_SQ = 1e20; // (1e10 m)²
      function searchPass(angleCapRad) {
        for (const radius of [4, 8, 16, 32, 60]) {
          let best = null, bestScore = Infinity;
          for (let dx = -radius; dx <= radius; dx++) {
            for (let dy = -radius; dy <= radius; dy++) {
              for (let dz = -radius; dz <= radius; dz++) {
                const objs = getChunk(ccx + dx, ccy + dy, ccz + dz);
                for (const obj of objs) {
                  if (obj.bg || !AUTOPILOT_TYPES.includes(obj.type)) continue;
                  const k = poiKey(obj);
                  if (autopilotVisited.includes(k)) continue;
                  const ddx = obj.wx - cam[0];
                  const ddy = obj.wy - cam[1];
                  const ddz = obj.wz - cam[2];
                  const d2 = ddx * ddx + ddy * ddy + ddz * ddz;
                  if (d2 < MIN_TRIP_DIST_SQ) continue;
                  let score;
                  if (haveDir) {
                    const dn = Math.sqrt(d2) || 1;
                    const fwd = Math.max(-1, Math.min(1, (ddx * refX + ddy * refY + ddz * refZ) / dn));
                    const angle = Math.acos(fwd);
                    if (angle > angleCapRad) continue;
                    // Quadratic angle penalty so small angles dominate.
                    // 0° at any dist beats 30° at the same distance.
                    score = d2 * (1 + angle * angle * 16);
                  } else {
                    score = d2;
                  }
                  if (score < bestScore) { bestScore = score; best = obj; }
                }
              }
            }
          }
          if (best) {
            autopilotVisited.push(poiKey(best));
            while (autopilotVisited.length > 500) autopilotVisited.shift();
            return best;
          }
        }
        return null;
      }
      // Strict forward cone ONLY. The old ±90°/±180° fallbacks would accept a
      // target anywhere around the camera, including behind it; since the view
      // now follows the heading, setting off for one would whip the whole sky
      // through a half-turn. Returning null is the better failure mode — the
      // caller leaves autopilotActive false and the camera keeps drifting
      // straight ahead until something enters the cone.
      return searchPass(autoCfg.maxAngleChange);
    }
    document.querySelectorAll('.coord-visit').forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = btn.dataset.type;
        const orig = btn.textContent;
        btn.textContent = '…';
        const target = findNearest(type, SEARCH_RADIUS[type] || 10);
        if (!target) {
          btn.textContent = 'none nearby';
          setTimeout(() => { btn.textContent = orig; }, 1500);
          return;
        }
        const approach = target.physRadius * (APPROACH_MUL[type] || 10);
        // Teleport to `approach` metres short of the body along -Z, then point
        // the view down +Z so the body is dead-ahead on arrival. Without the
        // reset the viewer would keep the heading they had before the jump and
        // the target would sit off-frame.
        teleport(target.wx, target.wy, target.wz - approach);
        viewDir[0] = 0; viewDir[1] = 0; viewDir[2] = 1;
        velocity[0] = 0; velocity[1] = 0; velocity[2] = 0;
        drifting = false;
        // Kill the autopilot too — with it running, the very next frame
        // acquires a new POI and warps away from the body the visitor just
        // asked to see, so the visit lasted milliseconds.
        if (autopilot) { autopilot = false; refreshAutopilotButton(); }
        viewLookBack = false;
        logEvent('visit ' + type, 'user');
        if (btnPause) btnPause.textContent = '▶ Resume';
        btn.textContent = orig;
      });
    });

    // ===== render =====
    function project(dx, dy, dz) {
      if (dz <= 1e6) return null; // behind/near plane (1 Mm)
      const k = focal / (dz / 1e15); // scale so that ~1e15 m maps reasonably
      return { px: cx + dx / 1e15 * k, py: cy + dy / 1e15 * k, k, dz };
    }
    // Doppler color shift: D > 1 blueshift, D < 1 redshift. Tuned for
    // subtle effects at low β (e.g. D≈1.36 at 0.3c → mild blue tint, not extreme).
    function dopplerColor(r, g, b, D) {
      const t = Math.max(-0.9, Math.min(2, D - 1));
      let nr, ng, nb;
      if (t >= 0) {
        nr = r * (1 - t * 0.18);
        ng = g * (1 - t * 0.05);
        nb = b * (1 + t * 0.22);
      } else {
        nr = r * (1 + (-t) * 0.25);
        ng = g * (1 + t * 0.05);
        nb = b * (1 + t * 0.35);
      }
      return ((Math.max(0, Math.min(255, nr | 0)) << 16) |
              (Math.max(0, Math.min(255, ng | 0)) << 8)  |
              (Math.max(0, Math.min(255, nb | 0))));
    }

    // ===== soft point-source sprite =====
    // A star is a glowing point, not a lit square. The stop profile below
    // reproduces the falloff measured off a real reference starfield —
    // 1.00 → 0.22 → 0.11 → 0.06 → 0.03 → 0 across the sprite radius — which is
    // a tight saturated core wrapped in a wide, very faint halo. That halo is
    // what makes a dot read as "star" rather than "pixel".
    //
    // Sprites are built once per quantised colour and blitted, never generated
    // per frame: at a few thousand stars a per-star createRadialGradient would
    // dominate the frame budget, whereas drawImage is a straight blit.
    const DOT_SPRITE_SIZE  = 32;   // sprite bitmap resolution
    const DOT_GLOW_SCALE   = 3.5;    // halo diameter = size × this
    const DOT_SPRITE_LIMIT = 128;  // cache cap, same eviction style as star textures
    const STAR_HALO_ALPHA  = 0.13; // skirt brightness as a fraction of the core's
    const STAR_HALO_MIN_A  = 0.35; // only genuinely bright stars get a skirt; each one costs a blit

    // ===== distant-star look =====
    // How far each star's spectral colour is pushed toward white. Real stars
    // are near-colourless to the naked eye because they are too dim to engage
    // cone vision; the reference field measures at saturation ≈0.07, which is
    // what 0.9 lands on. Set to 1 for literally white, 0 for full spectral hue.
    const STAR_WHITEN = 0.9;
    // Exponent on the final alpha. >1 pushes the population dim so only a
    // handful of stars are genuinely bright, matching the reference's strongly
    // dim-skewed brightness histogram instead of an evenly-lit field.
    const STAR_GAMMA = 1.35;
    // Scintillation depth: alpha swings between (1 - this) and 1 of its value.
    const STAR_TWINKLE = 0.55;
    // Scintillation speed, radians/sec of wall-clock. Each star gets 0.6-1.6× of
    // this from its hash, so at 0.22 the population breathes on ~24-48s cycles.
    // Raise for busier sparkle, lower for a calmer sky.
    const STAR_TWINKLE_HZ = 0.22;
    // Floor on a star's drawn size, in CSS px. Below ~1px a star is sub-pixel:
    // antialiasing spreads its alpha across neighbours and it washes out to
    // nothing. The render volume holds thousands of distant stars that were
    // being drawn at 0.6px and thus effectively not drawn at all, which is why
    // open sky looked empty while clusters looked fine.
    const STAR_MIN_PX = 1.0;
    // How much brightness survives at maximum render distance. The old curve
    // bottomed out at 0.25, which combined with the size floor above put far
    // stars under the visibility threshold. Raising the floor is what fills the
    // sky in — it does not add a single new object.
    const STAR_DEPTH_FLOOR = 0.45;
    const dotSpriteCache = new Map();
    function getDotSprite(r, g, b) {
      // Quantise to 16 levels/channel so Doppler-shifted variants of the same
      // star share one sprite instead of thrashing the cache.
      const key = ((r >> 4) << 8) | ((g >> 4) << 4) | (b >> 4);
      const hit = dotSpriteCache.get(key);
      if (hit) return hit;
      const S = DOT_SPRITE_SIZE, half = S / 2;
      const cv = document.createElement('canvas');
      cv.width = S; cv.height = S;
      const sc = cv.getContext('2d');
      const c = `${(r >> 4) * 17},${(g >> 4) * 17},${(b >> 4) * 17}`;
      // This sprite is the HALO ONLY — the core is drawn separately in
      // drawStar. So it wants a smooth, slowly-decaying skirt with no hard
      // centre: a bright centre here would fight the core and re-create the
      // blob. Overall skirt intensity is set by STAR_HALO_ALPHA at draw time.
      const gr = sc.createRadialGradient(half, half, 0, half, half, half);
      gr.addColorStop(0.00, `rgba(${c},1)`);
      gr.addColorStop(0.30, `rgba(${c},0.75)`);
      gr.addColorStop(0.55, `rgba(${c},0.35)`);
      gr.addColorStop(0.78, `rgba(${c},0.12)`);
      gr.addColorStop(1.00, `rgba(${c},0)`);
      sc.fillStyle = gr;
      sc.fillRect(0, 0, S, S);
      if (dotSpriteCache.size >= DOT_SPRITE_LIMIT) {
        dotSpriteCache.delete(dotSpriteCache.keys().next().value);
      }
      dotSpriteCache.set(key, cv);
      return cv;
    }

    // Core and halo are drawn SEPARATELY rather than as one sprite. A single
    // sprite couples them: making the core survive downscaling forces a wide
    // bright blob, and tightening the blob dissolves the core. Split, each is
    // controlled on its own — a crisp point carrying the star's real alpha,
    // plus a much fainter wide skirt. That reproduces the reference profile,
    // which is a saturated peak dropping to ~0.2 within a single pixel and
    // then trailing off slowly.
    // Style strings are cached, not rebuilt. Relativistic aberration folds the
    // whole sky into the forward cone at cruise, so upward of 18,000 stars can
    // be on screen at once; building an `rgba(...)` string per star per frame
    // is ~18k allocations every 16ms. Colour is quantised to 4 bits/channel
    // (whitening collapses stars to near-white anyway) and alpha to 64 steps,
    // which is finer than the eye can track on a twinkling 1px dot.
    const styleCache = new Map();
    function starStyle(r, g, b, a) {
      const q = ((r >> 4) << 14) | ((g >> 4) << 10) | ((b >> 4) << 6) | (a * 63) | 0;
      let s = styleCache.get(q);
      if (s === undefined) {
        // Cheap guard against unbounded growth if colours ever spread out.
        if (styleCache.size > 8192) styleCache.clear();
        s = `rgba(${(r >> 4) * 17},${(g >> 4) * 17},${(b >> 4) * 17},${(((a * 63) | 0) / 63).toFixed(3)})`;
        styleCache.set(q, s);
      }
      return s;
    }

    // Star dots go to the GL point-sprite layer when available; the 2d path
    // below survives purely as the no-WebGL fallback.
    // Draws one arc of a planet's ring system. Called twice per planet — far
    // half before the body, near half after — so the sphere occludes the ring
    // where it passes behind. `a0`/`a1` select the arc in canvas ellipse
    // parameter space (π..2π = far/top, 0..π = near/bottom).
    //
    // The tilt is derived from the object hash instead of the old fixed 0.4
    // rad: every ringed planet used to sit at exactly the same angle, which
    // read as a decal. Sign varies too, so some rings lean the other way.
    const RING_INNER = 1.24, RING_OUTER = 2.08;   // in planet radii
    // Radial opacity profile across the ring plane, t = 0 at the inner edge.
    // Real ring systems are not uniform bands — they are a near-continuous
    // sheet cut by resonance gaps, faint on the inside, tapering outside. The
    // gaussian notches are the gaps (the wide one at t≈0.47 stands in for the
    // Cassini division); the sine term is fine ringlet structure.
    function ringDensity(t) {
      let d = 1;
      d *= 1 - 0.94 * Math.exp(-Math.pow((t - 0.47) / 0.050, 2));  // major division
      d *= 1 - 0.55 * Math.exp(-Math.pow((t - 0.79) / 0.028, 2));  // narrow outer gap
      d *= 1 - 0.40 * Math.exp(-Math.pow((t - 0.14) / 0.045, 2));  // inner gap
      d *= 0.80 + 0.20 * Math.sin(t * 47.0);                       // ringlets
      d *= 0.35 + 0.65 * Math.min(1, t / 0.16);                    // faint inner (C-ring)
      d *= 1 - 0.55 * Math.max(0, (t - 0.86) / 0.14);              // outer taper
      return d < 0 ? 0 : d > 1 ? 1 : d;
    }
    // One half of a planet's ring system. Drawn as many thin concentric arcs
    // sampled from ringDensity rather than a few thick strokes, which is what
    // gives the sheet its gaps and grain. `half` is 'far' (behind the body,
    // painted first) or 'near' (in front, painted last).
    function drawPlanetRing(obj, proj, rad, depth, half) {
      const rr = mulberry32(objHash(obj) ^ 0x1234);
      const tilt = (rr() - 0.5) * 1.5;
      // Ring plane openness. Near zero the ring is edge-on — correct, and it
      // renders as a thin bright line the way a real one does.
      const openness = 0.10 + Math.abs(Math.sin(tilt)) * 0.52;
      // Icy, not the planet's own colour — the old version tinted rings with
      // the body hue, which is the main reason they read as painted-on. Real
      // ring particles are water ice and rock: pale grey through warm tan.
      const warm = rr();
      const ir = 196 + warm * 40, ig = 188 + warm * 26, ib = 176 + warm * 4;
      const far = half === 'far';
      const a0 = far ? Math.PI : 0, a1 = far ? Math.PI * 2 : Math.PI;
      // Far arc reads slightly dimmer: seen across the ring plane and partly
      // veiled by the near sheet.
      const ringA = Math.min(0.78, 0.42 + depth * 0.5) * (far ? 0.82 : 1);
      const bands = rad > 70 ? 52 : rad > 26 ? 32 : rad > 8 ? 18 : 8;
      const step = rad * (RING_OUTER - RING_INNER) / bands;

      // Light direction. Same seed as the day/night terminator below, so the
      // shadows agree with the lit hemisphere instead of contradicting it —
      // the previous version offset the ring shadow straight down regardless
      // of where the light was coming from.
      const lightPhase = mulberry32(objHash(obj) + 0xab)() * Math.PI * 2;
      const lx = Math.cos(lightPhase), ly = Math.sin(lightPhase);

      // Ring's shadow cast ONTO the planet — near pass only, where the body is
      // already painted. Displaced along the ANTI-light direction so it falls
      // on the lit face, which is the only place a shadow can be seen.
      if (!far && rad > 14) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(proj.px, proj.py, rad * 0.995, 0, Math.PI * 2);
        ctx.clip();
        ctx.lineWidth = step * 1.6;
        const ox = -lx * rad * 0.10, oy = -ly * rad * 0.10;
        for (let i = 0; i < bands; i++) {
          const t = (i + 0.5) / bands;
          const dens = ringDensity(t);
          if (dens < 0.05) continue;
          const rx = rad * (RING_INNER + (RING_OUTER - RING_INNER) * t);
          ctx.strokeStyle = `rgba(0,0,0,${(0.5 * dens).toFixed(3)})`;
          ctx.beginPath();
          ctx.ellipse(proj.px + ox, proj.py + oy, rx, rx * openness, tilt, 0, Math.PI * 2);
          ctx.stroke();
        }
        ctx.restore();
      }

      ctx.lineWidth = step * 1.15;   // slight overlap so bands abut seamlessly
      for (let i = 0; i < bands; i++) {
        const t = (i + 0.5) / bands;
        const dens = ringDensity(t);
        if (dens < 0.03) continue;
        const rx = rad * (RING_INNER + (RING_OUTER - RING_INNER) * t);
        const a = ringA * dens;
        ctx.strokeStyle = `rgba(${ir | 0},${ig | 0},${ib | 0},${a.toFixed(3)})`;
        ctx.beginPath();
        ctx.ellipse(proj.px, proj.py, rx, rx * openness, tilt, a0, a1);
        ctx.stroke();
      }

      // Planet's shadow falling ACROSS the rings. This is the one that was
      // wrong twice over: it clipped to the planet's own disc, so the body —
      // painted immediately afterwards — covered all but a 4% sliver of it,
      // and a planet's shadow does not sit on its silhouette anyway. It is a
      // wedge thrown OUTWARD along the anti-light direction, the dark band
      // you see cutting across Saturn's rings. Clipping to that half-strip
      // (width = the planet's diameter, extending away from the light) puts
      // it where it belongs, and applying it to both halves means the near
      // arc gets shadowed too.
      if (rad > 14) {
        const theta = lightPhase + Math.PI;   // point +x down the anti-light axis
        ctx.save();
        ctx.translate(proj.px, proj.py);
        ctx.rotate(theta);
        ctx.beginPath();
        ctx.rect(0, -rad, rad * RING_OUTER * 1.3, rad * 2);
        ctx.clip();
        ctx.lineWidth = step * 1.3;
        for (let i = 0; i < bands; i++) {
          const t = (i + 0.5) / bands;
          const dens = ringDensity(t);
          if (dens < 0.05) continue;
          const rx = rad * (RING_INNER + (RING_OUTER - RING_INNER) * t);
          ctx.strokeStyle = `rgba(0,0,0,${(0.62 * dens).toFixed(3)})`;
          ctx.beginPath();
          // Frame is rotated by theta, so cancel it out of the ellipse tilt.
          ctx.ellipse(0, 0, rx, rx * openness, tilt - theta, a0, a1);
          ctx.stroke();
        }
        ctx.restore();
      }
    }

    function drawStar(px, py, r, g, b, alpha, size) {
      const a = alpha < 0 ? 0 : alpha > 1 ? 1 : alpha;
      if (starGL) { starGL.push(px, py, size, r, g, b, a); return; }
      if (a > STAR_HALO_MIN_A) {
        const d = size * DOT_GLOW_SCALE;
        ctx.globalAlpha = a * STAR_HALO_ALPHA;
        ctx.drawImage(getDotSprite(r, g, b), px - d / 2, py - d / 2, d, d);
        ctx.globalAlpha = 1;
      }
      ctx.fillStyle = starStyle(r, g, b, a);
      if (size > 1.5) {
        ctx.beginPath();
        ctx.arc(px, py, size / 2, 0, Math.PI * 2);
        ctx.fill();
      } else {
        ctx.fillRect(px - size / 2, py - size / 2, size, size);
      }
    }

    // ===== deterministic value noise + fBm =====
    function vnoise(x, y, seed) {
      const xi = Math.floor(x);
      const yi = Math.floor(y);
      const xf = x - xi;
      const yf = y - yi;
      function h(ix, iy) {
        let v = (seed ^ Math.imul(ix | 0, 0x9E3779B1)) >>> 0;
        v = (Math.imul(v ^ ((iy | 0) * 0x85EBCA6B), 0xC2B2AE35)) >>> 0;
        v = (v ^ (v >>> 13)) >>> 0;
        return (v & 0xFFFFFF) / 0xFFFFFF;
      }
      const a = h(xi, yi);
      const b = h(xi + 1, yi);
      const c = h(xi, yi + 1);
      const d = h(xi + 1, yi + 1);
      const u = xf * xf * (3 - 2 * xf);
      const v = yf * yf * (3 - 2 * yf);
      return (a * (1 - u) + b * u) * (1 - v) + (c * (1 - u) + d * u) * v;
    }
    function fbm2(x, y, seed, octaves) {
      let amp = 0.5, freq = 1, total = 0;
      for (let i = 0; i < octaves; i++) {
        total += amp * vnoise(x * freq, y * freq, (seed + i * 1009) >>> 0);
        amp *= 0.5;
        freq *= 2;
      }
      return total;
    }

    // ===== planet texture cache — generated once per planet =====
    const planetTexCache = new Map();
    const PLANET_TEX_LIMIT = 120;
    const PLANET_TEX_SIZE = 256;
    function getPlanetTexture(obj) {
      const key = objHash(obj);
      let tex = planetTexCache.get(key);
      if (tex) return tex;
      tex = buildPlanetTexture(obj, key);
      if (planetTexCache.size >= PLANET_TEX_LIMIT) {
        // Evict oldest (Map preserves insertion order)
        const firstKey = planetTexCache.keys().next().value;
        planetTexCache.delete(firstKey);
      }
      planetTexCache.set(key, tex);
      return tex;
    }
    function buildPlanetTexture(obj, seed) {
      const SIZE = PLANET_TEX_SIZE;
      const canvasT = document.createElement('canvas');
      canvasT.width = SIZE;
      canvasT.height = SIZE;
      const cx2 = canvasT.getContext('2d');
      const id = cx2.createImageData(SIZE, SIZE);
      const data = id.data;
      const center = SIZE / 2;
      const radPx = center - 1;
      const kind = obj.kind || 'rocky';
      // Pick a storm/feature location deterministically (used by gas giants)
      const stormX = ((seed & 0xff) / 255) * 1.4 - 0.7;
      const stormY = (((seed >> 8) & 0xff) / 255) * 0.6 - 0.3;

      for (let y = 0; y < SIZE; y++) {
        for (let x = 0; x < SIZE; x++) {
          const dx = (x - center) / radPx;
          const dy = (y - center) / radPx;
          const r2 = dx * dx + dy * dy;
          const i = (y * SIZE + x) * 4;
          if (r2 >= 1) { data[i + 3] = 0; continue; }
          const z = Math.sqrt(1 - r2);
          // Spherical mapping for surface coords
          const lon = Math.atan2(dx, z) / Math.PI; // -1..1
          const lat = Math.asin(Math.max(-1, Math.min(1, dy))) / (Math.PI / 2); // -1..1

          let cr, cg, cb;

          if (kind === 'gas_giant') {
            const turb = fbm2(lon * 1.5, lat * 6, seed, 4);
            const bandV = 0.5 + 0.5 * Math.sin(lat * 8 + turb * 2);
            const k = 0.65 + bandV * 0.6;
            cr = obj.cr * k + (turb - 0.5) * 60;
            cg = obj.cg * k + (turb - 0.5) * 40;
            cb = obj.cb * k + (turb - 0.5) * 20;
            const sd = (dx - stormX) * (dx - stormX) * 0.5 + (dy - stormY) * (dy - stormY) * 1.4;
            if (sd < 0.018) {
              const tS = 1 - Math.sqrt(sd / 0.018);
              cr = cr * (1 - tS) + 215 * tS;
              cg = cg * (1 - tS) + 80 * tS;
              cb = cb * (1 - tS) + 55 * tS;
            }
          } else if (kind === 'ice_giant') {
            const bandN = fbm2(lon * 1.2, lat * 4, seed, 3);
            const k = 0.85 + bandN * 0.3;
            cr = obj.cr * k; cg = obj.cg * k; cb = obj.cb * k;
          } else if (kind === 'ocean') {
            const n = fbm2(lon * 3 + 50, lat * 3, seed, 5);
            if (n > 0.52) {
              const t = Math.min(1, (n - 0.52) / 0.35);
              cr = 95 + t * 70; cg = 120 + t * 55; cb = 60 + t * 30;
            } else {
              const d2 = (0.52 - n) / 0.52;
              cr = 35 + d2 * 25; cg = 80 + d2 * 30; cb = 165 + d2 * 35;
            }
            const cn = fbm2(lon * 6 + 200, lat * 6, seed + 7777, 3);
            if (cn > 0.6) {
              const ca = (cn - 0.6) / 0.4 * 0.55;
              cr = cr * (1 - ca) + 245 * ca;
              cg = cg * (1 - ca) + 245 * ca;
              cb = cb * (1 - ca) + 245 * ca;
            }
          } else if (kind === 'iceworld') {
            cr = 215; cg = 228; cb = 245;
            const cn = fbm2(lon * 3 + 12, lat * 3, seed, 4);
            const lineN = fbm2(lon * 18 + 90, lat * 18, seed + 31, 2);
            if (cn < 0.42) { cr -= 35; cg -= 28; cb -= 18; }
            if (lineN > 0.78) { cr -= 90; cg -= 70; cb -= 30; }
          } else if (kind === 'lava') {
            const n = fbm2(dx * 4 + 5, dy * 4, seed, 5);
            cr = 30; cg = 12; cb = 8;
            if (n > 0.52) {
              const t = Math.pow((n - 0.52) / 0.48, 1.3);
              cr = 30 + t * 225;
              cg = 12 + t * 175;
              cb = 8 + t * 35;
            }
          } else if (kind === 'shrouded') {
            const n = fbm2(lon * 2.5, lat * 2.5, seed, 3);
            const k = 0.88 + n * 0.22;
            cr = obj.cr * k; cg = obj.cg * k; cb = obj.cb * k;
          } else {
            // rocky / desert — texture noise + crater pits
            const n = fbm2(lon * 4 + 3, lat * 4, seed, 5);
            const k = 0.65 + n * 0.5;
            cr = obj.cr * k; cg = obj.cg * k; cb = obj.cb * k;
            const cn = fbm2(lon * 20 + 50, lat * 20, seed + 333, 2);
            if (cn > 0.74) {
              const t = (cn - 0.74) / 0.26;
              cr *= 1 - t * 0.45;
              cg *= 1 - t * 0.45;
              cb *= 1 - t * 0.45;
            }
          }

          // Sphere shading: limb darkening — bright at center, darker at edge
          const lightAng = -0.55; // light from upper-left
          const lightX = Math.cos(lightAng);
          const lightY = Math.sin(lightAng);
          const lighting = Math.max(0, dx * lightX + dy * lightY + z * 0.9);
          const shade = 0.18 + lighting * 0.95;
          cr = cr * shade;
          cg = cg * shade;
          cb = cb * shade;

          data[i]     = Math.max(0, Math.min(255, cr | 0));
          data[i + 1] = Math.max(0, Math.min(255, cg | 0));
          data[i + 2] = Math.max(0, Math.min(255, cb | 0));
          data[i + 3] = 255;
        }
      }
      cx2.putImageData(id, 0, 0);
      return canvasT;
    }

    // ===== star photosphere texture cache =====
    const starTexCache = new Map();
    const STAR_TEX_LIMIT = 80;
    const STAR_TEX_SIZE = 256;
    function getStarTexture(obj) {
      const key = objHash(obj);
      let tex = starTexCache.get(key);
      if (tex) return tex;
      tex = buildStarTexture(obj, key);
      if (starTexCache.size >= STAR_TEX_LIMIT) {
        const firstKey = starTexCache.keys().next().value;
        starTexCache.delete(firstKey);
      }
      starTexCache.set(key, tex);
      return tex;
    }
    function buildStarTexture(obj, seed) {
      const SIZE = STAR_TEX_SIZE;
      const canvasT = document.createElement('canvas');
      canvasT.width = SIZE;
      canvasT.height = SIZE;
      const cx2 = canvasT.getContext('2d');
      const id = cx2.createImageData(SIZE, SIZE);
      const data = id.data;
      const center = SIZE / 2;
      const radPx = center - 1;
      // Deterministic sunspot pairs (magnetic bipolar regions)
      const r = mulberry32(seed);
      const numSpotPairs = Math.floor(r() * 4); // 0-3 pairs
      const spots = [];
      for (let i = 0; i < numSpotPairs; i++) {
        const baseX = (r() - 0.5) * 1.4;
        const baseY = (r() - 0.5) * 1.4;
        const offset = 0.05 + r() * 0.08;
        const ang = r() * Math.PI * 2;
        const size = 0.025 + r() * 0.04;
        spots.push({ x: baseX + Math.cos(ang) * offset, y: baseY + Math.sin(ang) * offset, size });
        spots.push({ x: baseX - Math.cos(ang) * offset, y: baseY - Math.sin(ang) * offset, size });
      }
      // Base color brightness boost (stars are very bright)
      const br = Math.min(255, obj.cr * 1.1);
      const bg = Math.min(255, obj.cg * 1.1);
      const bb = Math.min(255, obj.cb * 1.1);
      for (let y = 0; y < SIZE; y++) {
        for (let x = 0; x < SIZE; x++) {
          const dx = (x - center) / radPx;
          const dy = (y - center) / radPx;
          const r2 = dx * dx + dy * dy;
          const i = (y * SIZE + x) * 4;
          if (r2 >= 1) { data[i + 3] = 0; continue; }
          const z = Math.sqrt(1 - r2);
          // Convection cell granulation: fbm gives soft cellular pattern
          const gran = fbm2(dx * 22, dy * 22, seed, 4);
          // Cell-edge darkening: distance from mid-noise
          const cellShade = 0.75 + 0.5 * gran; // 0.75-1.25
          // Limb darkening — physically motivated: I/I0 = a + b*mu
          const limb = 0.35 + 0.65 * z;
          // Sunspots
          let spotShade = 1;
          for (let s = 0; s < spots.length; s++) {
            const sp = spots[s];
            const sd2 = (dx - sp.x) * (dx - sp.x) + (dy - sp.y) * (dy - sp.y);
            if (sd2 < sp.size * sp.size * 2.25) {
              const t = Math.sqrt(sd2) / sp.size;
              if (t < 1) spotShade = Math.min(spotShade, 0.22);
              else if (t < 1.5) spotShade = Math.min(spotShade, 0.55);
            }
          }
          const I = cellShade * limb * spotShade;
          data[i]     = Math.min(255, (br * I) | 0);
          data[i + 1] = Math.min(255, (bg * I) | 0);
          data[i + 2] = Math.min(255, (bb * I) | 0);
          data[i + 3] = 255;
        }
      }
      cx2.putImageData(id, 0, 0);
      return canvasT;
    }

    // ===== type-specific realistic surface rendering (legacy / unused fallback) =====
    function renderPlanetSurface(ctx, px, py, rad, obj) {
      const r = mulberry32(objHash(obj));
      const kind = obj.kind || 'rocky';
      ctx.save();
      ctx.beginPath(); ctx.arc(px, py, rad, 0, Math.PI * 2); ctx.clip();

      if (kind === 'gas_giant' || kind === 'ice_giant') {
        // Zonal bands: parallel stripes of varying brightness across the disc
        const bands = 8 + Math.floor(r() * 6);
        for (let b = 0; b < bands; b++) {
          const t0 = b / bands;
          const t1 = (b + 1) / bands;
          const y0 = py + (t0 * 2 - 1) * rad;
          const y1 = py + (t1 * 2 - 1) * rad;
          const k = kind === 'gas_giant' ? 0.65 + r() * 0.55 : 0.80 + r() * 0.30;
          const drift = (r() - 0.5) * 30;
          const cr = Math.max(0, Math.min(255, Math.floor(obj.cr * k + drift)));
          const cg = Math.max(0, Math.min(255, Math.floor(obj.cg * k + drift)));
          const cb = Math.max(0, Math.min(255, Math.floor(obj.cb * k + drift)));
          ctx.fillStyle = `rgba(${cr},${cg},${cb},${kind === 'gas_giant' ? 0.55 : 0.35})`;
          ctx.fillRect(px - rad, y0, rad * 2, y1 - y0);
