    // that restores the page still lands on where the visitor actually was.
    const flushUrl = () => { if (urlPosStale()) updateUrl(); };
    window.addEventListener('pagehide', flushUrl);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') flushUrl();
    });

    // ===== deterministic PRNG seeded from chunk coords =====
    function hashChunk(x, y, z) {
      let h = 0xA1EC0DE >>> 0;
      h = Math.imul(h ^ (x | 0), 0x85EBCA6B) >>> 0;
      h = Math.imul(h ^ (y | 0), 0xC2B2AE35) >>> 0;
      h = Math.imul(h ^ (z | 0), 0x27D4EB2F) >>> 0;
      h = (h ^ (h >>> 16)) >>> 0;
      return h || 1;
    }
    // Stable per-object seed for deterministic LOD detail
    function objHash(o) {
      // Combine world coords; integer cast loses precision at very high coords but
      // that's fine — neighbouring objects still get distinct seeds.
      let h = 0x9E3779B1 >>> 0;
      h = Math.imul(h ^ ((o.wx / 1e10) | 0), 0x85EBCA6B) >>> 0;
      h = Math.imul(h ^ ((o.wy / 1e10) | 0), 0xC2B2AE35) >>> 0;
      h = Math.imul(h ^ ((o.wz / 1e10) | 0), 0x27D4EB2F) >>> 0;
      return (h ^ (h >>> 16)) >>> 0;
    }
    function mulberry32(seed) {
      let s = seed >>> 0;
      return function () {
        s = (s + 0x6D2B79F5) >>> 0;
        let t = s;
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    // ===== object types =====
    // Spectral classes, visually-weighted (real M dwarfs dominate by count but
    // are dim — we bias toward what'd actually appear in a dark sky).
    // [class, color, weight, pixelSizeMul, physRadius (m)]
    const SPECTRAL = [
      ['O',  [155, 176, 255], 0.005, 1.7,  1.0e10],
      ['B',  [170, 191, 255], 0.04,  1.45, 5.0e9],
      ['A',  [202, 215, 255], 0.08,  1.2,  2.0e9],
      ['F',  [248, 247, 255], 0.12,  1.05, 1.5e9],
      ['G',  [255, 244, 234], 0.18,  1.0,  1.0e9],
      ['K',  [255, 210, 161], 0.27,  0.88, 7.0e8],
      ['M',  [255, 160, 110], 0.305, 0.68, 3.0e8],
    ];
    function pickSpectral(r) {
      let acc = 0;
      for (const c of SPECTRAL) {
        acc += c[2];
        if (r < acc) return c;
      }
      return SPECTRAL[SPECTRAL.length - 1];
    }

    // Planet archetypes — each defines a base color and a render style. The
    // generator picks one from this list with the given weight, then renderer
    // draws type-specific realistic features (bands, craters, clouds, lava…).
    const PLANET_TYPES = [
      { kind: 'rocky',     color: [150, 110, 80],   weight: 0.30 }, // mercury/moon
      { kind: 'desert',    color: [200, 150, 95],   weight: 0.15 }, // mars/tatooine
      { kind: 'ocean',     color: [80, 130, 200],   weight: 0.15 }, // earth-like
      { kind: 'iceworld',  color: [200, 220, 240],  weight: 0.10 }, // europa
      { kind: 'gas_giant', color: [210, 175, 140],  weight: 0.16 }, // jupiter/saturn
      { kind: 'ice_giant', color: [110, 170, 220],  weight: 0.08 }, // uranus/neptune
      { kind: 'lava',      color: [200, 70, 40],    weight: 0.04 }, // hot rocky
      { kind: 'shrouded',  color: [210, 200, 130],  weight: 0.02 }, // venus-like sulfur
    ];
    function pickPlanetType(r) {
      let acc = 0;
      for (const t of PLANET_TYPES) {
        acc += t.weight;
        if (r < acc) return t;
      }
      return PLANET_TYPES[0];
    }
    const NEBULA_PALETTE = [
      [180, 100, 220],
      [220, 90, 150],
      [80, 160, 230],
      [230, 110, 90],
      [120, 200, 180],
    ];

    // Background stars added to EVERY chunk, on top of the sparse "interesting
    // body" roll below. Without these the sky is empty: only ~205 chunks fall
    // inside the view frustum and the body roll yields ~0.36 stars each, so
    // open space renders about 100 visible stars where a rich field needs
    // ~1000. These are scenery only — they are excluded from autopilot targets
    // and from the "visit star" search, so the tour still flies to real,
    // fully-featured stars. Cost is linear in chunks scanned, so this is the
    // one knob to turn down if the frame rate suffers on weak hardware.
    const BG_STARS_PER_CHUNK = 8;
    // Scenery draw radius, as a fraction of RENDER_DISTANCE. Under canvas2d
    // this had to sit at 0.45 — at full radius ~18,000 stars reached the
    // screen (relativistic aberration folds the whole sky into the forward
    // cone, so the off-screen cull never fires at cruise) and blitting them
    // cost ~25ms a frame. The GL point layer draws the same field in well
    // under a millisecond, so the radius is back to full and the per-chunk
    // count is higher: the JS collection loop is now the only real cost
    // (~4-6ms at ~25k stars). If a low-end machine struggles, lower these two
    // first.
    const BG_RENDER_FRAC = 1.0;
    const BG_RENDER_D2 = (RENDER_DISTANCE * BG_RENDER_FRAC) * (RENDER_DISTANCE * BG_RENDER_FRAC);
    // `depth` is 1 at the camera and 0 at RENDER_DISTANCE, so the cull edge
    // sits at this depth. Scenery fades out across a band just inside it,
    // otherwise stars would pop into existence as the camera advances.
    const BG_FADE_DEPTH = 1 - BG_RENDER_FRAC;
    const BG_FADE_BAND = 0.08;

    // ===== scenery screen-density budget =====
    // Stars per megapixel of viewport (CSS px). Relativistic aberration folds
    // the whole sky into the forward cone, so the on-screen count is a
    // function of SPEED, not of the field: measured 120-500 visible stars in
    // open sky at moderate speed against 13,346 at cruise in the same 538x551
    // viewport — one star per 22 px², packed tighter than a single dot's own
    // glow. Past that the dots overlap into a mottled sheet with dark lanes
    // between the saturated patches, which reads as a ripple.
    //
    // Nothing about the field is actually clustered: the measured two-point
    // correlation is ξ(r) = -0.07, FLAT from 11 to 134 px (a clumped field
    // would show a positive bump at the clump scale). So the fix belongs on
    // the count, not on the generator.
    //
    // Budgeting per megapixel rather than per frame also fixes the small-window
    // case: the angular field of view does not shrink with the window, so at
    // 538x551 the same sky landed on 1/11th the pixels of a 2560x1305 one.
    const BG_SCREEN_BUDGET_PER_MPX = 2600;
    // Survivors are chosen by a deterministic per-star hash, so it is the same
    // set of stars frame to frame — an independent draw each frame would make
    // the entire sky flicker. The ones nearest the cut fade across this
    // fraction of the keep window instead of popping as the budget drifts.
    const BG_THIN_FADE = 0.3;
    // Backstop against a runaway feedback loop, not a working value.
    const BG_THIN_MIN = 0.02;
    // Seconds for the keep fraction to close ~63% of the gap to its target.
    // Slow enough that the governor cannot oscillate against its own
    // measurement, fast enough to track an accelerating camera.
    const BG_THIN_TAU = 0.4;
    // Governor state. `bgKeptLast` is what actually reached the screen last
    // frame; dividing it by the fraction admitted recovers the unthinned
    // count, which is what the budget has to be compared against.
    let bgKeepFrac = 1;
    let bgKeptLast = 0;

    // ===== chunk generator =====
    function generateChunk(chx, chy, chz) {
      const r = mulberry32(hashChunk(chx, chy, chz));
      const cellRoll = r();
      // Most chunks empty — realistic interstellar sparsity
      let count = 0;
      if (cellRoll < 0.55) count = 0;
      else if (cellRoll < 0.92) count = 1;
      else if (cellRoll < 0.99) count = 2;
      else count = 3;

      const out = [];
      for (let i = 0; i < count; i++) {
        const wx = chx * CHUNK_SIZE + r() * CHUNK_SIZE;
        const wy = chy * CHUNK_SIZE + r() * CHUNK_SIZE;
        const wz = chz * CHUNK_SIZE + r() * CHUNK_SIZE;
        const t = r();
        const obj = { wx, wy, wz };
        if (t < 0.85) {
          const cls = pickSpectral(r());
          obj.type = 'star';
          obj.cr = cls[1][0];
          obj.cg = cls[1][1];
          obj.cb = cls[1][2];
          obj.sizeMul = cls[3];
          obj.physRadius = cls[4] * (0.7 + r() * 0.6); // 70%-130% of class typical
          obj.bri = 0.5 + r() * 0.5;
        } else if (t < 0.95) {
          const pt = pickPlanetType(r());
          obj.type = 'planet';
          obj.kind = pt.kind;
          obj.cr = pt.color[0]; obj.cg = pt.color[1]; obj.cb = pt.color[2];
          // Physical radius depends on kind — gas/ice giants are large, rocky are small
          if (pt.kind === 'gas_giant') obj.physRadius = 4e7 + r() * 8e7;       // 40-120k km
          else if (pt.kind === 'ice_giant') obj.physRadius = 2e7 + r() * 5e7;  // 20-70k km
          else if (pt.kind === 'shrouded')  obj.physRadius = 5e6 + r() * 1.5e7;
          else if (pt.kind === 'lava')      obj.physRadius = 2e6 + r() * 8e6;
          else obj.physRadius = 1.5e6 + r() * 1.2e7;                            // rocky/desert/ocean/ice
          // Rings: more common on gas giants
          obj.hasRing = r() < (pt.kind === 'gas_giant' ? 0.55 : 0.05);
        } else if (t < 0.992) {
          const n = NEBULA_PALETTE[Math.floor(r() * NEBULA_PALETTE.length)];
          obj.type = 'nebula';
          obj.cr = n[0]; obj.cg = n[1]; obj.cb = n[2];
          obj.scale = 0.6 + r() * 1.4;
          // 0.05 – 1 light-year diameter cloud
          obj.physRadius = 5e14 + r() * 1e16 * obj.scale;
        } else {
          obj.type = 'blackhole';
          obj.scale = 0.5 + r() * 0.6;
          // 1e8 to 1e12 m event horizon (stellar to intermediate-mass)
          obj.physRadius = 1e8 + r() * 1e12;
        }
        out.push(obj);
      }
      // Scenery layer. Same spectral distribution as real stars so the field
      // keeps its colour character, but marked `bg` and given no features
      // worth flying to. Drawn from the SAME rng stream, after the body roll,
      // so a chunk's contents stay fully determined by its coordinates.
      for (let i = 0; i < BG_STARS_PER_CHUNK; i++) {
        const cls = pickSpectral(r());
        out.push({
          wx: chx * CHUNK_SIZE + r() * CHUNK_SIZE,
          wy: chy * CHUNK_SIZE + r() * CHUNK_SIZE,
          wz: chz * CHUNK_SIZE + r() * CHUNK_SIZE,
          type: 'star',
          bg: true,
          cr: cls[1][0], cg: cls[1][1], cb: cls[1][2],
          sizeMul: cls[3],
          physRadius: cls[4] * (0.7 + r() * 0.6),
          bri: 0.5 + r() * 0.5,
        });
      }
      return out;
    }

    function getChunk(chx, chy, chz) {
      const k = chx + '|' + chy + '|' + chz;
      let v = chunkCache.get(k);
      if (!v) {
        v = generateChunk(chx, chy, chz);
        if (chunkCache.size >= CACHE_LIMIT) {
          // Lazy eviction: drop oldest 20%
          let i = 0;
          const toDrop = Math.floor(CACHE_LIMIT * 0.2);
          for (const key of chunkCache.keys()) {
            if (i++ >= toDrop) break;
            chunkCache.delete(key);
          }
        }
        chunkCache.set(k, v);
      }
      return v;
    }

    // ===== viewport =====
    let W = 0, H = 0, cx = 0, cy = 0, dpr = 1, focal = 0;
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth;
      H = window.innerHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (starGL) starGL.resize(W, H, dpr);
      cx = W / 2; cy = H / 2;
      focal = Math.max(W, H) * FOCAL_BASE;
    }
    resize();
    window.addEventListener('resize', resize);

    // ===== UI =====
    const elX = document.getElementById('coord-x');
    const elY = document.getElementById('coord-y');
    const elZ = document.getElementById('coord-z');
    const elV = document.getElementById('coord-v');
    const elB = document.getElementById('coord-beta');
    const inp = document.getElementById('coord-input');
    const form = document.getElementById('coord-form');
    const btnOrigin = document.getElementById('coord-origin');
    const btnRandom = document.getElementById('coord-random');
    const btnPause = document.getElementById('coord-pause');

    function fmt(n) {
      if (!Number.isFinite(n)) return '—';
      const a = Math.abs(n);
      if (a < 1000) return n.toFixed(0);
      return n.toExponential(3);
    }
    function fmtVelocity(v) {
      if (v <= 0) return '0 m/s';
      const cMult = v / C;
      let cUnit;
      if (cMult < 1) cUnit = cMult.toFixed(3) + 'c';
      else if (cMult < 1e3) cUnit = cMult.toFixed(2) + 'c';
      else if (cMult < 1e6) cUnit = (cMult / 1e3).toFixed(2) + 'kc';
      else if (cMult < 1e9) cUnit = (cMult / 1e6).toFixed(2) + 'Mc';
      else cUnit = (cMult / 1e9).toFixed(2) + 'Gc';
      return v.toExponential(2) + ' m/s · ' + cUnit;
    }
    function refreshUI() {
      if (!elX) return;
      elX.textContent = fmt(cam[0]);
      elY.textContent = fmt(cam[1]);
      elZ.textContent = fmt(cam[2]);
      elV.textContent = fmtVelocity(lastCamV);
      // β is min(1, v/c) by definition; cap at 0.999 so the readout stays
      // physical. When v exceeds c (super-luminal cruise) the value pins and
      // we append γ so the relativistic regime is still informative.
      // β and γ shown with continuous mappings so the readout actually
      // tracks velocity throughout the brake (including super-luminal phase):
      //   β = tanh(v/c)   — matches v/c for small v, asymptotes to 1
      //   γ = √(1 + (v/c)²) — matches physical γ at low v, grows linearly above c
      // Physical SR β/γ saturate at v=c which made both readouts pin during
      // every super-luminal trip. These extensions stay smooth.
      const vc = lastCamV / C;
      if (!isFinite(vc)) elB.textContent = '—';
      else {
        const betaDisp = Math.tanh(vc);
        const gammaDisp = Math.sqrt(1 + vc * vc);
        const gStr = gammaDisp >= 1000 ? gammaDisp.toExponential(6) : gammaDisp.toFixed(8);
        elB.textContent = 'β=' + betaDisp.toFixed(12) + ' γ=' + gStr;
      }
    }
    refreshUI();

    function teleport(x, y, z) {
      cam = [x, y, z];
      logEvent('teleport', 'user');
      refreshUI();
      savePosition();
      updateUrl();
    }

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const raw = (inp.value || '').trim();
        if (!raw) return;
        const parts = raw.split(/[\s,]+/).map(Number);
        if (parts.length !== 3 || !parts.every(Number.isFinite)) {
          inp.style.borderColor = '#dc2626';
          setTimeout(() => { inp.style.borderColor = ''; }, 1200);
          return;
        }
        teleport(parts[0], parts[1], parts[2]);
        inp.value = '';
      });
    }
    if (btnOrigin) {
      btnOrigin.addEventListener('click', () => teleport(0, 0, 0));
    }
    if (btnRandom) {
      btnRandom.addEventListener('click', () => {
        // Jump to a random spot within a meaningful range
        const span = 1e18;
        teleport(
          (Math.random() - 0.5) * span,
          (Math.random() - 0.5) * span,
          (Math.random() - 0.5) * span
        );
      });
    }
    if (btnPause) {
      btnPause.addEventListener('click', () => {
        drifting = !drifting;
        logEvent(drifting ? 'resume drift' : 'pause', 'user');
        btnPause.textContent = drifting ? '⏸ Pause' : '▶ Resume';
      });
    }
    const btnAutopilot = document.getElementById('coord-autopilot');
    function refreshAutopilotButton() {
      if (!btnAutopilot) return;
      btnAutopilot.classList.toggle('coord-speed-active', autopilot);
      btnAutopilot.textContent = autopilot ? '◉ Autopilot on' : '✦ Autopilot';
    }
    if (btnAutopilot) {
      btnAutopilot.addEventListener('click', () => {
        autopilot = !autopilot;
        logEvent('autopilot ' + (autopilot ? 'ON' : 'OFF'), 'user');
        refreshAutopilotButton();
        if (autopilot) {
          autoW = false;
          drifting = false;
          if (btnPause) btnPause.textContent = '▶ Resume';
          autopilotTarget = null;
          autopilotPhase = 'searching';
        }
      });
    }
    // Autopilot is enabled by default — kick off the tour immediately
    if (autopilot) {
      autoW = false;
      drifting = false;
      if (btnPause) btnPause.textContent = '▶ Resume';
    }
    refreshAutopilotButton();

    // ===== Debug panel for autopilot tuning =====
    // Debug panel is hidden in production (deployed builds). It auto-enables
    // on localhost dev, or anywhere with ?debug in the URL for ad-hoc tuning.
    const debugEnabled = (() => {
      try {
        const p = new URLSearchParams(location.search);
        if (p.has('nodebug')) return false;
        if (p.has('debug')) return true;
        const h = location.hostname;
        return h === 'localhost' || h === '127.0.0.1' || h === '';
      } catch (e) { return false; }
    })();
    const debugPanel = document.getElementById('debug-panel');
    const debugRowsEl = document.getElementById('debug-rows');
    const btnDebug = document.getElementById('coord-debug');
    if (debugEnabled && btnDebug) btnDebug.hidden = false;

    // Hide the entire coord-panel on deployed builds — it's a dev/debug surface.
    if (!debugEnabled) {
      const coordPanelEl = document.getElementById('coord-panel');
      if (coordPanelEl) coordPanelEl.style.display = 'none';
    }

    // ===== Deep debug panel (?debug) — live per-frame state stream =====
    const deepPanel = document.getElementById('deep-debug-panel');
    const deepSectionsEl = document.getElementById('deep-debug-sections');
    const deepOutputEl = document.getElementById('deep-debug-output');
    const btnDeepDebug = document.getElementById('coord-deep-debug');
    const btnDeepClose = document.getElementById('deep-debug-close');
    const btnDeepPause = document.getElementById('deep-debug-pause');
    const btnDeepCopy = document.getElementById('deep-debug-copy');
    if (debugEnabled && btnDeepDebug) btnDeepDebug.hidden = false;
    const deepSections = ['camera','basis','velocity','beta','autopilot','aberration','time','config','nearest'];
    const deepSectionsEnabled = { camera:true, basis:false, velocity:true, beta:true, autopilot:true, aberration:true, time:false, config:false, nearest:true };
    if (deepSectionsEl) {
      deepSections.forEach((s) => {
        const lbl = document.createElement('label');
        const cb = document.createElement('input');
        cb.type = 'checkbox'; cb.checked = !!deepSectionsEnabled[s]; cb.dataset.section = s;
        cb.addEventListener('change', () => { deepSectionsEnabled[s] = cb.checked; });
        const txt = document.createElement('span'); txt.textContent = s;
        lbl.appendChild(cb); lbl.appendChild(txt);
        deepSectionsEl.appendChild(lbl);
      });
    }
    let deepPaused = false;
    if (btnDeepPause) btnDeepPause.addEventListener('click', () => {
      deepPaused = !deepPaused;
      btnDeepPause.textContent = deepPaused ? 'Resume' : 'Pause';
    });
    if (btnDeepClose) btnDeepClose.addEventListener('click', () => {
      deepPanel.classList.add('hidden');
      deepPanel.setAttribute('aria-hidden', 'true');
    });
    if (btnDeepDebug) btnDeepDebug.addEventListener('click', () => {
      const open = deepPanel.classList.contains('hidden');
      deepPanel.classList.toggle('hidden', !open);
      deepPanel.setAttribute('aria-hidden', open ? 'false' : 'true');
    });
    if (btnDeepCopy) btnDeepCopy.addEventListener('click', async () => {
      const snapshot = deepOutputEl ? deepOutputEl.textContent : '';
      try { await navigator.clipboard.writeText(snapshot); btnDeepCopy.textContent = 'Copied!'; }
      catch (e) { btnDeepCopy.textContent = 'Copy failed'; }
      setTimeout(() => { btnDeepCopy.textContent = 'Copy snapshot'; }, 1200);
    });

    // State exposed to the deep-debug renderer (populated each frame).
    window.__deepState = {
      camera: null, basis: null, velocity: null, beta: null,
      autopilot: null, aberration: null, time: null, nearest: null,
    };
    function fmt(n) {
      if (n === null || n === undefined || Number.isNaN(n)) return '—';
      if (typeof n !== 'number') return String(n);
      if (n === 0) return '0';
      const abs = Math.abs(n);
      if (abs >= 1e6 || abs < 1e-3) return n.toExponential(3);
      return n.toFixed(4);
    }
    function fmtVec(a, b, c) { return '(' + fmt(a) + ', ' + fmt(b) + ', ' + fmt(c) + ')'; }
    function renderDeepDebug() {
      if (!deepOutputEl) return;
      if (deepPaused || deepPanel.classList.contains('hidden')) return;
      const s = window.__deepState;
      const lines = [];
      if (deepSectionsEnabled.camera && s.camera) {
        lines.push('[CAMERA]');
        lines.push('  pos  : ' + fmtVec(s.camera.x, s.camera.y, s.camera.z));
        lines.push('  yaw  : ' + fmt(s.camera.yaw) + '  (' + fmt(s.camera.yaw * 180/Math.PI) + '°)');
        lines.push('  pitch: ' + fmt(s.camera.pitch) + '  (' + fmt(s.camera.pitch * 180/Math.PI) + '°)');
        lines.push('');
      }
      if (deepSectionsEnabled.basis && s.basis) {
        lines.push('[CAMERA BASIS (world)]');
        lines.push('  forward: ' + fmtVec(s.basis.fx, s.basis.fy, s.basis.fz));
        lines.push('  right  : ' + fmtVec(s.basis.rx, s.basis.ry, s.basis.rz));
        lines.push('  up     : ' + fmtVec(s.basis.ux, s.basis.uy, s.basis.uz));
        lines.push('');
      }
      if (deepSectionsEnabled.velocity && s.velocity) {
        lines.push('[VELOCITY]');
        lines.push('  vec  : ' + fmtVec(s.velocity.x, s.velocity.y, s.velocity.z));
        lines.push('  |v|  : ' + fmt(s.velocity.mag) + '  m/s');
        lines.push('  v̂    : ' + fmtVec(s.velocity.ux, s.velocity.uy, s.velocity.uz));
        lines.push('  v·f̂  : ' + fmt(s.velocity.dotForward) + '  (cosine v vs camera-forward)');
        lines.push('');
      }
      if (deepSectionsEnabled.beta && s.beta) {
        lines.push('[RELATIVISTIC]');
        lines.push('  β       : ' + fmt(s.beta.beta));
        lines.push('  γ       : ' + fmt(s.beta.gamma));
        lines.push('  smoothβ : ' + fmt(s.beta.smooth));
        lines.push('');
      }
      if (deepSectionsEnabled.autopilot && s.autopilot) {
        lines.push('[AUTOPILOT]');
        lines.push('  enabled    : ' + s.autopilot.enabled);
        lines.push('  active     : ' + s.autopilot.active);
        lines.push('  phase      : ' + s.autopilot.phase);
        lines.push('  target     : ' + (s.autopilot.target || '—'));
        lines.push('  dist→tgt   : ' + fmt(s.autopilot.dist) + '  m');
        lines.push('  centreDist : ' + fmt(s.autopilot.centreDist) + '  m');
        lines.push('  closeThr   : ' + fmt(s.autopilot.closeThreshold) + '  m');
        lines.push('  baseSpeed  : ' + fmt(s.autopilot.baseSpeed) + '  m/s');
        lines.push('  travelTime : ' + fmt(s.autopilot.travelTime) + '  s');
        lines.push('  lingerTime : ' + fmt(s.autopilot.lingerTime) + '  s');
        lines.push('  next       : ' + (s.autopilot.next || '—'));
        lines.push('');
      }
      if (deepSectionsEnabled.aberration && s.aberration) {
        lines.push('[ABERRATION (target body)]');
