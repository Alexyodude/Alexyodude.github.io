---
// Coordinate-based procedural universe. Astrobodies are generated per
// spatial chunk by hashing the chunk's world coordinates — so every visitor
// at the same (x, y, z) sees the same scene. Camera auto-drifts on +Z. The
// position persists in localStorage (and via ?x=&y=&z= URL params for shares).
// Visitors can teleport to any coordinate.
---

<!-- Star dots render on the WebGL layer; bodies (planets, black holes,
     nebulae, close-up stars) render on the 2d canvas stacked above it, so
     they naturally occlude the field behind them. -->
<canvas id="bg-stars-gl" aria-hidden="true"></canvas>
<canvas id="bg-stars" aria-hidden="true"></canvas>

<aside id="coord-panel" class="hidden md:block">
  <div class="coord-panel-title">COORDINATES (m)</div>
  <div class="coord-rows">
    <div><span>x</span><b id="coord-x">0</b></div>
    <div><span>y</span><b id="coord-y">0</b></div>
    <div><span>z</span><b id="coord-z">0</b></div>
    <div><span>v</span><b id="coord-v">—</b></div>
    <div><span>β</span><b id="coord-beta">—</b></div>
  </div>
  <form id="coord-form" class="coord-form" autocomplete="off">
    <input id="coord-input" placeholder="x, y, z" aria-label="Teleport coordinates" spellcheck="false" />
    <button type="submit">Go</button>
  </form>
  <div class="coord-actions">
    <button type="button" id="coord-origin">↺ Origin</button>
    <button type="button" id="coord-random">⤳ Random</button>
    <button type="button" id="coord-pause">⏸ Pause</button>
    <button type="button" id="coord-autopilot">✦ Autopilot</button>
    <button type="button" id="coord-debug" hidden>🐞 Debug</button>
    <button type="button" id="coord-deep-debug" hidden>🔬 Deep</button>
  </div>
  <div class="coord-actions">
    <span class="coord-help" style="margin:0">visit</span>
    <button type="button" class="coord-visit" data-type="planet">planet</button>
    <button type="button" class="coord-visit" data-type="star">star</button>
    <button type="button" class="coord-visit" data-type="nebula">nebula</button>
    <button type="button" class="coord-visit" data-type="blackhole">black hole</button>
  </div>
  <div class="coord-help">WASD warp (hold = ramp) · Q/E up/down · pinch to thrust on touch</div>
</aside>

<aside id="deep-debug-panel" class="hidden" aria-hidden="true">
  <div class="debug-title">DEEP DEBUG — live state every frame</div>
  <div class="deep-debug-sections" id="deep-debug-sections"></div>
  <pre class="deep-debug-output" id="deep-debug-output"></pre>
  <div class="debug-actions">
    <button type="button" id="deep-debug-pause">Pause</button>
    <button type="button" id="deep-debug-copy">Copy snapshot</button>
    <button type="button" id="deep-debug-close">Close</button>
  </div>
</aside>

<aside id="debug-panel" class="hidden" aria-hidden="true">
  <div class="debug-title">AUTOPILOT TUNING</div>
  <div class="debug-rows" id="debug-rows"></div>
  <div class="debug-actions">
    <button type="button" id="debug-next-poi">Next POI</button>
    <button type="button" id="debug-reset">Reset</button>
    <button type="button" id="debug-copy">Copy config</button>
    <button type="button" id="debug-close">Close</button>
  </div>
  <div class="debug-help">Sliders update live. "Copy config" puts the current values on your clipboard — paste back into <code>autoCfg</code> at the top of the script to make them the new defaults.</div>
</aside>

<aside id="debug-plot-panel" class="hidden" aria-hidden="true">
  <div class="debug-title">WARP TIMELINE</div>
  <canvas id="debug-curve-canvas" width="320" height="120"></canvas>
  <div class="debug-title" style="margin-top:6px">REALTIME · log|v| + events</div>
  <!-- Sized from its container at runtime (the panel is resizable), not from
       these attributes — they are only the pre-script fallback. -->
  <canvas id="event-timeline-canvas" style="width:100%;height:150px;display:block"></canvas>
</aside>

