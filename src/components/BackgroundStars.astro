      autopilotCruiseTime = cruiseTime + cruiseHold;
      // Time-based brake completes at t=aT+cruiseTime+dT (closed-form sizes
      // peak so brakeWidth fits the remaining distance budget). Don't add
      // finalSec — final approach piggybacks on the same window when peak
      // is super-luminal; adding it stretches the marker past actual arrival
      // and the marker snaps to 1 at lingering trigger.
      autopilotExpectedAccel = aT;
      autopilotExpectedCruise = autopilotCruiseTime;
      autopilotExpectedDecel = dT + decelDelay;
      autopilotExpectedDuration = Math.max(0.1, aT + autopilotCruiseTime + dT + decelDelay);
    }
    const autopilotOffset = [0, 0, 0]; // perpendicular fly-by offset (so we pass on the side)
    const nextAutopilotOffset = [0, 0, 0]; // fly-by offset for the queued next target
    const autopilotVisited = []; // ring buffer of recent target keys to avoid loops
    // Mutable autopilot tuning — bound to the debug UI sliders below.
    // Tweak via the debug panel, then click "Copy config" and paste the snippet
    // back into this object to lock in the new defaults.
    const autoCfg = {
      linger: 7,                   // seconds spent near each POI
      approachPlanet: 6,           // per-type approach distance multiplier (× physRadius)
      approachStar: 18,
      approachBlackhole: 50,
      decelCorridorMul: 4,         // brake corridor — slowdown only kicks in inside threshold × this
      decelPower: 1,               // ease exponent — < 1 (e.g. 0.5) gives constant-deceleration feel; 1 is linear in distance; > 1 cruises then dumps
      designSpeedDivisor: 15,      // designSpeed = closeThreshold / (linger × this)
      velocityLerp: 1,             // velocity smoothing rate during autopilot (post-block low-pass)
      maxWarpExp: 18,              // ceiling on autopilot warp speed in m/s = 10^this — 1e18 = ~3.3B·c (smoothness guaranteed by multiplicative ramp + stableCap)
      maxAngleChange: 0.524,       // 30° — hard forward cone, no fallback widening. The view follows the heading, so this caps how far it swings when a new leg begins. Lower it for gentler transitions (at the cost of more straight drifting between targets).
      accelTimeSec: 1.0,           // seconds to ramp from designSpeed up to baseSpeed at travel start
      accelPower: 2.3,             // ramp curve exponent (1=linear, 2=ease-in quad, 3=cubic, 4=quart)
      flybyOffset: 0,              // perpendicular fly-by offset, in multiples of closeThreshold (0 = head-on, 2 = pass at 2× approach radius)
      warpCurveOffset: 1.0,        // cruise plateau as fraction of maxWarpExp ceiling (1 = full warp, 0.5 = half-warp cruise)
      cruiseMinSec: 0,             // extra hold time at peak warp before decel can start (lengthens cruise plateau)
      decelOffsetSec: 0,           // delay before decel begins (shifts the brake later in the timeline)
      arrivalDriftFrac: 1.0,       // linger drift speed as fraction of designSpeed (used only when passByVelC = 0)
      passByVelC: 3,               // linger drift speed in units of c — set the absolute pass-by velocity directly. 0 = use arrivalDriftFrac legacy formula
      arrivalHoldSec: 0,           // hold motionless at arrival for N sec before drifting (a dramatic "we're here" pause)
      decelTimeSec: 2.5,           // brake duration in seconds — long by default so arrivals glide rather than slam
      decelGaussianA: 0,           // when > 0, brake follows e^(-a·x²) — low values (0.1) feel like a cliff; try ≥ 2 for a soft Gaussian shape
      decelAtanA: 0,               // when > 0, brake follows v = b·(π/2 − atan(a·x − π/2)) with x = 1-distU, normalized — sigmoid S-curve
      decelMirrorAccel: 0,         // 1 = mirror accel: decel uses accelTimeSec/accelPower instead of decelTimeSec/decelPower
      finalApproachVelC: 0,        // when > 0, brake curve drops to this many c then a linear ramp glides to designSpeed (causes derivative skip; off by default)
      finalApproachSec: 7,         // seconds of slow linear ramp from finalApproachVelC down to designSpeed (only used when finalApproachVelC > 0)
      tripTimeMin: 6,              // minimum random travel time per trip (seconds)
      tripTimeMax: 16,             // maximum random travel time per trip (seconds) — picks peakVel to match
      preSearchDelaySec: 1.5,      // seconds of linger to warp before searching for the next POI
    };
    let autopilotTripTargetSec = 5; // randomized per trip (autoCfg.tripTimeMin..tripTimeMax)
    let autopilotForceRefresh = false; // set true from debug panel "Next POI" button
    function autoApproachFor(type) {
      if (type === 'planet') return autoCfg.approachPlanet;
      if (type === 'star') return autoCfg.approachStar;
      if (type === 'blackhole') return autoCfg.approachBlackhole;
      return 18;
    }
    const AUTOPILOT_TYPES = ['planet', 'star', 'blackhole'];
    let lastFrameMs = performance.now();
    let simClockSec = 0; // accumulated capped dt — the autopilot schedule clock
    let lastSavedMs = 0;
    let lastNearestD = Infinity; // distance to closest object, tracked each frame for auto-slowdown
    let lastNearestR = 0;        // physical radius of that object — sets a minimum movement speed
    let shiftHold = 0;           // seconds Shift has been held while moving; drives ramp acceleration
    const chunkCache = new Map();

    function readInitial() {
      // URL params take priority — for shared links
      try {
        const u = new URLSearchParams(location.search);
        if (u.has('x') && u.has('y') && u.has('z')) {
          const a = ['x', 'y', 'z'].map((k) => parseFloat(u.get(k)));
          if (a.every(Number.isFinite)) return a;
        }
      } catch {}
      // Every fresh visit gets a brand-new random region of the universe
      const span = 1e18;
      return [
        (Math.random() - 0.5) * span,
        (Math.random() - 0.5) * span,
        (Math.random() - 0.5) * span,
      ];
    }

    function savePosition() {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(cam)); } catch {}
    }
    // URL sync is deliberately infrequent. Chrome records same-document
    // navigations in its history database, so rewriting the URL on the render
    // cadence — this used to fire every 500 ms, ~6800 writes an hour — floods
    // the visitor's browser history with thousands of near-identical
    // coordinate URLs and leaves the address bar visibly churning.
    //
    // Nothing depends on that frequency. Position persistence is localStorage's
    // job and still runs every 500 ms; the URL exists only so a coordinate can
    // be shared. So it is refreshed on deliberate navigation, on a slow idle
    // cadence while actually travelling, and once as the page goes away.
    const URL_SYNC_MS = 30000;
    let lastUrlMs = -Infinity;
    // Seeded from the position we loaded with, so arriving via a shared link
    // and not moving writes nothing — the URL is already correct.
    let lastUrlPos = [cam[0], cam[1], cam[2]];
    // Below this the camera hasn't meaningfully gone anywhere, so a rewrite
    // would add a history entry pointing essentially where the last one did.
    const URL_MIN_MOVE = CHUNK_SIZE * 0.05;
    function urlPosStale() {
      if (!lastUrlPos) return true;
      const dx = cam[0] - lastUrlPos[0];
      const dy = cam[1] - lastUrlPos[1];
      const dz = cam[2] - lastUrlPos[2];
      return dx * dx + dy * dy + dz * dz > URL_MIN_MOVE * URL_MIN_MOVE;
    }
    function updateUrl() {
      try {
        const u = new URL(location.href);
        u.searchParams.set('x', cam[0].toExponential(3));
        u.searchParams.set('y', cam[1].toExponential(3));
        u.searchParams.set('z', cam[2].toExponential(3));
