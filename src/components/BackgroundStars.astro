          gl.enableVertexAttribArray(ap);
          gl.vertexAttribPointer(ap, 2, gl.FLOAT, false, 0, 0);
          gl.drawArrays(gl.TRIANGLES, 0, 6);
        },
        hasBodies() { return !!bodyProg; },
        count() { return n; },
      };
    })();

    // ===== world constants =====
    const STORAGE_KEY = 'universe.cam.v2';
    const RENDER_DISTANCE = 2e19;   // meters — about 2100 light-years
    const CHUNK_SIZE      = 2e18;   // meters — about 210 light-years per chunk
    const N_RADIUS        = Math.ceil(RENDER_DISTANCE / CHUNK_SIZE); // chunks in each axis
    // Drift cruise velocity = c × TIME_MUL (capped at β=0.999 for relativistic
    // effects). Animations (planet rotation, star flares, BH disc spin) run on
