                if (elapsedT < aT) {
                  const u = elapsedT / aT;
                  // Quintic smootherstep: 6u^5 − 15u^4 + 10u^3.
                  // Zero first AND second derivatives at u=0 and u=1, so the
                  // handoff from rest → accel → cruise is C² continuous —
                  // bodies in the background never "snap" speed.
                  const smooth = u * u * u * (u * (u * 6 - 15) + 10);
                  // accelPower biases front- vs back-load WITHIN the smooth
                  // envelope by remapping the smoothstep output, so the knob
                  // still does something without re-introducing endpoint kinks.
                  const p = Math.max(0.2, autoCfg.accelPower);
                  const ease = p === 1 ? smooth : Math.pow(smooth, p);
                  const rampFloor = Math.max(autopilotStartVel, designSpeed);
                  curveVel = rampFloor + (peakVel - rampFloor) * ease;
                } else {
                  curveVel = peakVel;
                }
              } else {
                // Brake — TIME-based curve. decelTimeSec actually controls how
                // long the deceleration takes (was distance-based, where the
                // sub-c portion collapsed to one frame at super-luminal peak).
                //   v(t) = designSp + (brakeStartVel − designSp) · ease(brakeU)
                //   brakeU = (tAnimSec − autopilotBrakeStart) / decelTimeSec
                // ease(u) goes from 1 at u=0 (just entered brake) to 0 at u=1
                // (brake duration elapsed). Power / Gaussian / atan all share
                // the same role: `1 - u` maps to "fraction of brake remaining".
                if (autopilotBrakeStart < 0) {
                  autopilotBrakeStart = tAnimSec;
                }
                const brakeT = tAnimSec - autopilotBrakeStart;
                const brakeU = Math.max(0, Math.min(1, brakeT / dT));
                const aG = autoCfg.decelGaussianA || 0;
                const aA = autoCfg.decelAtanA || 0;
                let ease;
                if (aA > 0) {
                  const PI6 = 3.141593;
                  const x = brakeU;
                  const r1 = PI6 / 2 - Math.atan(-PI6 / 2);
                  const r0 = PI6 / 2 - Math.atan(aA - PI6 / 2);
                  const rv = PI6 / 2 - Math.atan(aA * x - PI6 / 2);
                  ease = (rv - r0) / Math.max(1e-9, r1 - r0);
                } else if (aG > 0) {
                  const x = brakeU;
                  const tail = Math.exp(-aG);
                  ease = (Math.exp(-aG * x * x) - tail) / Math.max(1e-9, 1 - tail);
                } else {
                  // Smootherstep brake (mirror of accel ramp): the previous
                  // `(1−u)^dPow` curve had a nonzero derivative at u=0, so the
                  // transition from constant cruise into brake produced a
                  // dv/dt cliff — bodies in view appeared to snap-decelerate.
                  // 6u^5 − 15u^4 + 10u^3 has zero first AND second derivatives
                  // at u=0 and u=1, so cruise→brake→designSpeed is C² smooth
                  // and the background continues moving smoothly throughout.
                  const u = brakeU;
                  const smooth = u * u * u * (u * (u * 6 - 15) + 10);
                  const p = Math.max(0.2, dPow);
                  const sk = p === 1 ? smooth : Math.pow(smooth, p);
                  ease = 1 - sk;
                }
                curveVel = designSpeed + (peakVel - designSpeed) * Math.max(0, Math.min(1, ease));
              }
              // Final-approach takeover (DISABLED by default): the takeover
              // produces a derivative discontinuity at the switchover point —
              // brake derivative is ~10⁵× larger than the linear final-ramp
              // derivative, which the user sees as a "skipping" transition.
              // With time-based brake the dist budget already matches
              // closeThreshold; the takeover is only useful as a knob, kept
              // behind `finalApproachVelC > 0`.
              // toward the body before the final-approach takeover kicks in.
              const finalVcRaw = autoCfg.finalApproachVelC || 0;
              const finalEnabled = finalVcRaw > 0;
              const finalThresh = finalEnabled ? finalVcRaw * C : 0;
              const finalT = Math.max(0.1, autoCfg.finalApproachSec || 3);
              const inBrakeZone = dist < brakeStartDist;
              if (finalEnabled && inBrakeZone && (curveVel < finalThresh || autopilotFinalStart >= 0)) {
                if (autopilotFinalStart < 0) {
                  autopilotFinalStart = tAnimSec;
                  autopilotFinalEntryVel = Math.max(curveVel, designSpeed);
                }
                const fU = Math.max(0, Math.min(1, (tAnimSec - autopilotFinalStart) / finalT));
                curveVel = autopilotFinalEntryVel + (designSpeed - autopilotFinalEntryVel) * fU;
              }
              // Anticipatory brake: never be moving faster than "reach the
              // approach threshold in ~1.2s". Without this, warp speeds cover
              // the whole remaining trip in under one frame and the per-frame
              // safetyCap slams velocity down 5-7 decades instantly — the
              // vertical cliffs on the realtime strip. This cap engages EARLY
              // and shrinks with distance, so the same braking happens as a
              // smooth ~0.3 decades/s log-linear descent instead of a wall.
              const brakeCap = designSpeed + Math.max(0, dist - closeThreshold) / VEL_BRAKE_ANTICIPATION_S;
              // The bell curve is TIME-scheduled; the brake cap is DISTANCE-
              // shaped. When braking makes the trip run longer than planned,
              // the time-curve expires mid-flight and collapses to
              // designSpeed while the ship is still astronomically far — a
              // permanent crawl (observed: 16 years to target). When the plan
              // has exhausted itself (curveVel at its floor) but we are not
              // actually close, ride the distance profile home instead: it
              // converges on the threshold with a ~1.2s time constant,
              // log-linearly, no cliff.
              // No distance guard: the profile equals designSpeed AT the
              // threshold, so riding it is correct at every range. (A 2×thr
              // guard here created a dead zone where the ship crawled at 30R.)
              const planExhausted = curveVel <= designSpeed * 1.05;
              let baseSpeed = planExhausted
                ? Math.min(safetyCap, brakeCap)
                : Math.min(curveVel, safetyCap, brakeCap);
              // Don't accelerate while the camera isn't looking where we are
              // going. After a transit the view is still swung round at the
              // star behind; without this the ship is already climbing toward
              // warp during the whole forward turn, so the departure happens
              // off-screen and the turn ends on a view that is already racing.
              // Speed is held to a fraction until the gaze catches up, then
              // released — the log slew limiter smooths the hand-back.
              {
                const dn2 = Math.sqrt(dx*dx + dy*dy + dz*dz) || 1;
                const align = (viewDir[0]*dx + viewDir[1]*dy + viewDir[2]*dz) / dn2;
                // Release only when the gaze is genuinely on target. The old
                // mapping hit f=1 at align≈0.9 — about 25° out — and with the
                // slower turn those last degrees take seconds, during which
                // the gate was already fully open and the warp curve climbed
                // back to thousands of c mid-turn. Requiring ~0.995 (≈6°)
                // keeps the ship slow until the sky has stopped swinging.
                const f = Math.max(0, Math.min(1, (align - 0.90) / 0.095));
                // Geometric hold, NOT a multiplier. The warp curve grows
                // exponentially, so scaling it by a fraction still leaves it
                // exponential — measured 43 million c mid-turn at a 0.12
                // multiplier. Interpolating in LOG space between the current
                // speed and the commanded one pins the ceiling to what we are
                // already doing until the gaze catches up, then hands back
                // smoothly (f=0 → hold, f=1 → full command).
                // The cap doesn't just HOLD speed during the turn, it decays
                // toward the arrival speed, so the ship actively slows while
                // it comes about. That matters visually as much as
                // mechanically: at high β relativistic aberration crushes the
                // starfield into a bright knot around the direction of
                // travel, so turning at speed swings that knot across frame
                // and the stars read as clumped somewhere arbitrary. Slow to
                // low β first and the sky is near-uniform, so the turn shows
                // an even field rotating rather than a blob sliding.
                // Decaying from lastVelMag (not snapping to designSpeed)
                // keeps the slowdown itself smooth.
                const decay = Math.pow(2, -VEL_TURN_SLOWDOWN_OCT_S * dt);
                const cap = Math.max(designSpeed, lastVelMag * decay);
                if (f < 1 && baseSpeed > cap) {
                  baseSpeed = cap * Math.pow(baseSpeed / cap, f);
                }
              }
              const dn = Math.sqrt(dx * dx + dy * dy + dz * dz) || 1;
              const tdx = dx / dn, tdy = dy / dn, tdz = dz / dn;
              const smoothedMag = baseSpeed;
              velocity[0] = tdx * smoothedMag;
              velocity[1] = tdy * smoothedMag;
              velocity[2] = tdz * smoothedMag;
              tvx = velocity[0]; tvy = velocity[1]; tvz = velocity[2];
            } else {
              const isTransit = autopilotTarget.type === 'star';
              if (isTransit) {
                // ===== fly-THROUGH transit (stars) =====
                // Velocity stays aimed straight through the centre (snapAim
                // set it at arrival and nothing here bends it). Speed is a
                // pure function of distance-to-surface, symmetric about the
                // star: exponential brake on the way in (τ≈2s), a slow
                // interior crossing, the mirrored ramp back out. The body is
                // dead-centre the entire time because the view IS the
                // velocity. Exit: once receding past TRANSIT_EXIT_R radii the
                // linger timer is force-expired so the normal handoff runs.
                const R = targetRadius;
                const surf = Math.max(0, centreDist - R);
                const approaching = (cdx * velocity[0] + cdy * velocity[1] + cdz * velocity[2]) > 0;
                // Timeline stamps for the crossing milestones.
                if (lastTransitDist > R && centreDist <= R) logEvent('ENTER star surface', 'transit');
                if (lastTransitDist <= R && centreDist > R) logEvent('EXIT star surface', 'transit');
                if (lastTransitApproaching && !approaching) {
                  logEvent('core crossing', 'transit');
                  // Flip the view while the interior hides the sky: the
                  // visitor emerges facing BACK at the star and watches it
                  // recede for the whole exit leg.
                  viewLookBack = true;
                  logEvent('view: look back', 'user');
                }
                lastTransitDist = centreDist;
                lastTransitApproaching = approaching;
                // Interior floor and ramp shape. The floor sets the crossing
                // time (2R / floor); the divisor sets how gently speed decays
                // toward the surface and builds after it — larger = softer
                // entry/exit, longer trip. Tuned after "going in and out are
                // very snappy": crossing ~7s, boundary transitions ~2s.
                const vTransit = R / TRANSIT_CROSS_S;
                let speed = Math.max(vTransit, surf / TRANSIT_RAMP_S);
                // Rotation slowdown, smoothly on BOTH sides of the core.
                // Inbound: a proximity dip — speed eases 1× → 0.25× linearly
                // with distance to the core, so the brake for the flip builds
                // over the whole inbound half instead of stepping ×0.25 the
                // frame the flip starts. Outbound: the proximity factor would
                // rise again, so the flip-alignment factor (0.25× until the
                // 180° turn completes, eased by the view's own turn rate)
                // holds it down; the ship releases only once it is actually
                // facing back. min() of the two keeps every hand-off C0.
                {
                  const prox = centreDist < R ? 0.25 + 0.75 * (centreDist / R) : 1;
                  let alignF = 1;
                  if (viewLookBack) {
                    const vm3 = Math.sqrt(velocity[0]*velocity[0] + velocity[1]*velocity[1] + velocity[2]*velocity[2]) || 1;
                    const align = -(viewDir[0]*velocity[0] + viewDir[1]*velocity[1] + viewDir[2]*velocity[2]) / vm3;
                    alignF = 0.25 + 0.75 * Math.max(0, Math.min(1, (align + 0.2) / 1.15));
                  }
                  speed *= Math.min(prox, alignF);
                }
                const curMag = Math.sqrt(velocity[0]*velocity[0] + velocity[1]*velocity[1] + velocity[2]*velocity[2]);
                if (curMag > 1) {
                  const k = speed / curMag;
                  velocity[0] *= k; velocity[1] *= k; velocity[2] *= k;
                } else {
                  // dead stop (shouldn't happen mid-transit): push toward centre
                  velocity[0] = cdx / Math.max(1, centreDist) * speed;
                  velocity[1] = cdy / Math.max(1, centreDist) * speed;
                  velocity[2] = cdz / Math.max(1, centreDist) * speed;
                }
                if (!approaching && centreDist > R * TRANSIT_EXIT_R && !autopilotTransitDone) {
                  autopilotTransitDone = true;
                  logEvent('transit clear @' + TRANSIT_EXIT_R + 'R', 'transit');
                }
              } else {
              // Linger: arrival behaviour. Two knobs:
              //   arrivalHoldSec   — freeze in place for N sec after arrival
              //   arrivalDriftFrac — drift speed as fraction of designSpeed
              const sinceArrival = tAnimSec - autopilotLingerStart;
              const driftFrac = Math.max(0, Math.min(1, autoCfg.arrivalDriftFrac));
              const holdSec = Math.max(0, autoCfg.arrivalHoldSec || 0);
              const curMag = Math.sqrt(velocity[0]*velocity[0] + velocity[1]*velocity[1] + velocity[2]*velocity[2]);
              // passByVelC overrides the legacy designSpeed×driftFrac formula:
              // 0 = legacy, > 0 = absolute drift velocity in units of c.
              const passByVc = autoCfg.passByVelC || 0;
              const driftTarget = passByVc > 0 ? passByVc * C : designSpeed * driftFrac;
              const targetMag = sinceArrival < holdSec ? 0 : driftTarget;
              const lerp = Math.min(1, dt * 3.5);
              const newMag = curMag + (targetMag - curMag) * lerp;
              if (curMag > 1) {
                velocity[0] = velocity[0] / curMag * newMag;
                velocity[1] = velocity[1] / curMag * newMag;
                velocity[2] = velocity[2] / curMag * newMag;
              } else {
                velocity[0] = fx * targetMag;
                velocity[1] = fy * targetMag;
                velocity[2] = fz * targetMag;
              }
              }
              tvx = velocity[0]; tvy = velocity[1]; tvz = velocity[2];
            }
          }
          } // end of "else (autopilotTarget exists after handoff)"
        }
      }
      if (!autopilotActive && drifting) {
        const ds = DRIFT_V * TIME_MUL;
        tvx += fx * ds; tvy += fy * ds; tvz += fz * ds;
      }
      // Manual WASD/QE — auto-scales by proximity to nearest object.
      // Far from anything: full speed. Approach an object → smooth slowdown so
      // navigation stays precise. Shift for warp cruise (also scaled but capped).
      const wHeld = !autopilotActive && (keys.has('w') || autoW);
      if (!autopilotActive && (keys.size || autoW)) {
        const isMoving = wHeld || keys.has('a') || keys.has('s') || keys.has('d') ||
                         keys.has('q') || keys.has('e') || keys.has(' ');
        // Always ramp: holding any movement key (or auto-W) exponentially boosts speed.
        // Reaches ~1e10× over ~5s, capping at ~1e18 m/s (~100 ly/s).
        if (isMoving) shiftHold += dt;
        else shiftHold = 0;
        const shiftMul = Math.min(1e10, Math.exp(shiftHold * 4.6));

        const proxFactor = lastNearestD === Infinity
          ? 1
          : Math.min(1, Math.max(0.005, lastNearestD / 1e13));
        const base = 1e8; // ~0.33c default — sub-light so a tap of W doesn't pin β to 0.999
        // sizeFloor only applies when close to an object, and is hard-capped so
        // huge-radius objects (nebulae) don't make WASD warp instantly.
        const sizeFloor = (lastNearestD < lastNearestR * 12)
          ? Math.min(5e9, lastNearestR * 0.5)
          : 0;
        let speed = Math.max(base * proxFactor, sizeFloor);
        speed *= shiftMul;
        // Add manual velocity components (m/s, camera-local axes)
        if (wHeld) { tvx += fx * speed; tvy += fy * speed; tvz += fz * speed; }
        if (keys.has('s')) { tvx -= fx * speed; tvy -= fy * speed; tvz -= fz * speed; }
        if (keys.has('d')) { tvx += rx * speed; tvy += ry * speed; tvz += rz * speed; }
        if (keys.has('a')) { tvx -= rx * speed; tvy -= ry * speed; tvz -= rz * speed; }
        if (keys.has('q') || keys.has(' ')) { tvx += ux * speed; tvy += uy * speed; tvz += uz * speed; }
        if (keys.has('e')) { tvx -= ux * speed; tvy -= uy * speed; tvz -= uz * speed; }
      }
      // Smooth current velocity toward target. Faster response during autopilot
      // so warp ramp doesn't eat half the trip; gentler for manual feel otherwise.
      const lerpV = Math.min(1, dt * (autopilotActive ? autoCfg.velocityLerp : 3.5));
      velocity[0] += (tvx - velocity[0]) * lerpV;
      velocity[1] += (tvy - velocity[1]) * lerpV;
      velocity[2] += (tvz - velocity[2]) * lerpV;
      // ===== velocity DIRECTION rate limiter =====
      // The lerp above smooths magnitude but not direction: the autopilot's
      // arrival redirect and handoff snap-aim rewrite velocity[] wholesale, so
      // its direction used to teleport 30-90° in a single frame. Every
      // relativistic visual — the aberration light-tunnel, Doppler tint,
      // beaming — keys off velocity direction, as does the on-screen star
      // flow, so each phase change cut the whole sky's shading to a new
      // direction in one frame even though the geometric view eased. Capping
      // how fast the direction can turn makes those cuts play out as sweeps:
      // 90° arrival redirect ≈ 1.8s, ~33° handoff ≈ 0.7s. Magnitude is
      // untouched — braking and warp ramps behave exactly as before.
      {
        const m = Math.sqrt(velocity[0]*velocity[0] + velocity[1]*velocity[1] + velocity[2]*velocity[2]);
        if (m > 1 && lastVelDirMag > 1) {
          const nx = velocity[0]/m, ny = velocity[1]/m, nz = velocity[2]/m;
          const dot = Math.max(-1, Math.min(1, nx*lastVelDir[0] + ny*lastVelDir[1] + nz*lastVelDir[2]));
          const ang = Math.acos(dot);
          const maxStep = VEL_TURN_RATE * Math.PI/180 * dt;
          if (ang > maxStep) {
            // nlerp by the allowed fraction, then renormalise — accurate
            // enough at per-frame step sizes and far cheaper than slerp.
            const f = maxStep / ang;
            let cx = lastVelDir[0] + (nx - lastVelDir[0]) * f;
            let cy2 = lastVelDir[1] + (ny - lastVelDir[1]) * f;
            let cz = lastVelDir[2] + (nz - lastVelDir[2]) * f;
            const cn = Math.sqrt(cx*cx + cy2*cy2 + cz*cz) || 1;
            cx /= cn; cy2 /= cn; cz /= cn;
            velocity[0] = cx * m; velocity[1] = cy2 * m; velocity[2] = cz * m;
            lastVelDir[0] = cx; lastVelDir[1] = cy2; lastVelDir[2] = cz;
          } else {
            lastVelDir[0] = nx; lastVelDir[1] = ny; lastVelDir[2] = nz;
          }
        } else if (m > 1) {
          // Starting from rest (teleport, visit button): adopt the new
          // direction immediately — there is no old heading to sweep from.
          lastVelDir[0] = velocity[0]/m; lastVelDir[1] = velocity[1]/m; lastVelDir[2] = velocity[2]/m;
        }
        lastVelDirMag = m;
      }
      // ===== velocity MAGNITUDE slew limiter (upward only) =====
      // The direction limiter above stops the vector turning abruptly, but
      // nothing stopped it SCALING abruptly — the realtime strip showed two
      // vertical cliffs per trip: arrival (the transit profile taking over
      // from the brake corridor a decade higher) and handoff (transit-exit
      // speed leaping to warp). Cap the upward rate in log-space so speed-ups
      // sweep across decades instead of teleporting. Deceleration is
      // deliberately UNBOUNDED: the brake clamps are collision safety, and
      // capping them would overshoot the camera into bodies.
      {
        const m2 = Math.sqrt(velocity[0]*velocity[0] + velocity[1]*velocity[1] + velocity[2]*velocity[2]);
        if (m2 > 1 && lastVelMag > 1 && m2 > lastVelMag) {
          const maxUp = lastVelMag * Math.pow(10, VEL_SLEW_DECADES_PER_S * dt);
          if (m2 > maxUp) {
            const k = maxUp / m2;
            velocity[0] *= k; velocity[1] *= k; velocity[2] *= k;
            lastVelMag = maxUp;
          } else lastVelMag = m2;
        } else lastVelMag = m2;
      }
      // Apply smoothed velocity to camera position
      cam[0] += velocity[0] * dt;
      cam[1] += velocity[1] * dt;
      cam[2] += velocity[2] * dt;
      const camV = Math.sqrt(velocity[0] * velocity[0] + velocity[1] * velocity[1] + velocity[2] * velocity[2]);
      lastCamV = camV;
      sampleTimeline(camV);
      if (debugPlotPanel && !debugPlotPanel.classList.contains('hidden')) drawEventTimeline();
      // Sample velocity for the debug curve overlay (only while autopilot is
      // traveling — the overlay is the trip's velocity profile).
      if (autopilotActive && autopilotPhase === 'traveling') {
        autopilotVelHistory.push({ t: tAnimSec - autopilotTravelStart, v: camV });
        if (autopilotVelHistory.length > VEL_HISTORY_LIMIT) autopilotVelHistory.shift();
      }

      // Populate the deep-debug snapshot (the panel polls this at 10Hz).
      if (window.__deepState) {
        const vUxS = camV > 1 ? velocity[0]/camV : 0;
        const vUyS = camV > 1 ? velocity[1]/camV : 0;
        const vUzS = camV > 1 ? velocity[2]/camV : 0;
        const dotForward = vUxS * fx + vUyS * fy + vUzS * fz;
        window.__deepState.camera = { x: cam[0], y: cam[1], z: cam[2], yaw, pitch };
        window.__deepState.basis = { fx, fy, fz, rx, ry, rz, ux, uy, uz };
        window.__deepState.velocity = { x: velocity[0], y: velocity[1], z: velocity[2], mag: camV, ux: vUxS, uy: vUyS, uz: vUzS, dotForward };
        const betaNow = Math.min(0.999, camV / C);
        window.__deepState.beta = { beta: betaNow, gamma: 1/Math.sqrt(1 - betaNow*betaNow), smooth: smoothBeta };
        window.__deepState.time = { tAnim, tAnimSec, dt, fps: dt > 0 ? 1/dt : 0 };
        // Scenery density governor — `kept` is what reached the canvas,
        // `unthinned` what would have without the budget. Exposed because the
        // budget is the one constant here that has to be tuned by measurement.
        window.__deepState.scenery = {
          kept: bgKeptLast,
          keepFrac: bgKeepFrac,
          unthinned: Math.round(bgKeptLast / Math.max(BG_THIN_MIN, bgKeepFrac)),
          budget: Math.round(BG_SCREEN_BUDGET_PER_MPX * (W * H) / 1e6),
          perMpx: Math.round(bgKeptLast / ((W * H) / 1e6)),
        };
        let apInfo = { enabled: autopilot, active: !!autopilotActive, phase: autopilotPhase, target: null, dist: 0, centreDist: 0, closeThreshold: 0, baseSpeed: 0, travelTime: 0, lingerTime: 0, next: null };
        if (autopilotTarget) {
          const tdx0 = (autopilotTarget.wx + autopilotOffset[0]) - cam[0];
          const tdy0 = (autopilotTarget.wy + autopilotOffset[1]) - cam[1];
          const tdz0 = (autopilotTarget.wz + autopilotOffset[2]) - cam[2];
          const distAp = Math.sqrt(tdx0*tdx0 + tdy0*tdy0 + tdz0*tdz0);
          const cdx0 = autopilotTarget.wx - cam[0];
          const cdy0 = autopilotTarget.wy - cam[1];
          const cdz0 = autopilotTarget.wz - cam[2];
          const cDist = Math.sqrt(cdx0*cdx0 + cdy0*cdy0 + cdz0*cdz0);
          const aRad = autopilotTarget.physRadius || 1e9;
          const aMul = autoApproachFor(autopilotTarget.type);
          const cThr = aRad * aMul;
          // Mirror the actual physics baseSpeed formula so the panel
          // reflects the real cap.
          const warpCap = Math.pow(10, autoCfg.maxWarpExp);
          const corridor = cThr * autoCfg.decelCorridorMul;
          const designSp = cThr / (autoCfg.linger * autoCfg.designSpeedDivisor);
          const decelSp = distAp > corridor
            ? warpCap
            : designSp + (warpCap - designSp) * Math.pow(Math.max(0, Math.min(1, (distAp - cThr) / (corridor - cThr))), autoCfg.decelPower);
          const remainingSnap = Math.max(distAp - cThr, cThr * 0.05);
          const stableCapSnap = remainingSnap / Math.max(dt, 1e-6) * 0.5;
          const bSpd = Math.min(decelSp, warpCap, stableCapSnap);
          apInfo.target = autopilotTarget.type + ' r=' + fmt(aRad);
          apInfo.dist = distAp; apInfo.centreDist = cDist; apInfo.closeThreshold = cThr;
          apInfo.baseSpeed = bSpd;
          apInfo.travelTime = autopilotPhase === 'traveling' ? (tAnimSec - autopilotTravelStart) : 0;
          apInfo.lingerTime = autopilotPhase === 'lingering' ? (tAnimSec - autopilotLingerStart) : 0;
          if (nextAutopilotTarget) apInfo.next = nextAutopilotTarget.type + ' r=' + fmt(nextAutopilotTarget.physRadius || 0);
          // Aberration breakdown for the target body
          const oM = Math.sqrt(cdx0*cdx0 + cdy0*cdy0 + cdz0*cdz0) || 1;
          const nxA = cdx0/oM, nyA = cdy0/oM, nzA = cdz0/oM;
          const ctV = camV > 1 ? (nxA*vUxS + nyA*vUyS + nzA*vUzS) : 0;
          const ctP = (camV > 1 && smoothBeta > 0.005) ? (ctV + smoothBeta) / (1 + smoothBeta * ctV) : ctV;
          const gammaA = 1 / Math.sqrt(1 - smoothBeta * smoothBeta);
          const dA = gammaA * (1 + smoothBeta * ctV);
          window.__deepState.aberration = { nx: nxA, ny: nyA, nz: nzA, cosTvel: ctV, cosTp: ctP, D: dA, shiftDeg: (Math.acos(Math.max(-1,Math.min(1,ctP))) - Math.acos(Math.max(-1,Math.min(1,ctV)))) * 180/Math.PI };
        } else {
          window.__deepState.aberration = null;
        }
        window.__deepState.autopilot = apInfo;
        if (lastNearestD < Infinity) {
          window.__deepState.nearest = { dist: lastNearestD, radius: lastNearestR, ratio: lastNearestR > 0 ? lastNearestD / lastNearestR : Infinity };
        } else { window.__deepState.nearest = null; }
      }
      if (nowMs - lastSavedMs > 500) {
        // localStorage and the on-screen readout are free to run often — they
        // touch no browser history. The URL is on its own much slower clock.
        savePosition();
        refreshUI();
        lastSavedMs = nowMs;
      }
      maybeUpdateUrl(nowMs);

      ctx.clearRect(0, 0, W, H);
      // The site is dark only. `dark` is kept as a local constant rather than
      // threaded out of every renderer, so the per-object draw code reads the
      // same as before; the light branches are gone.
      const dark = true;
      if (starGL) starGL.begin();

      const ccx = Math.floor(cam[0] / CHUNK_SIZE);
      const ccy = Math.floor(cam[1] / CHUNK_SIZE);
      const ccz = Math.floor(cam[2] / CHUNK_SIZE);
      // Relativistic β smoothed across frames so it ramps gradually instead of
      // β target uses the relativistic-momentum mapping
      //   β = (v/c) / √(1 + (v/c)²)
      // so β varies smoothly throughout the brake (including super-luminal
      // phase) instead of saturating at 0.999 the moment v >= c. Without
      // this, all visual SR effects (aberration / Doppler / time dilation /
      // length contraction) freeze during cruise + most of decel and only
      // change in the last fraction when v finally drops below c.
      // Matches the γ readout = √(1 + (v/c)²) for self-consistency.
      const vc = camV / C;
      const targetBeta = Math.min(0.999, vc / Math.sqrt(1 + vc * vc));
      smoothBeta += (targetBeta - smoothBeta) * Math.min(1, dt * 2);
      const beta = smoothBeta;

      // Iterate the full cube around the camera (we can now look in any direction)
      const minDz = -N_RADIUS;
      const maxDz = N_RADIUS;
      const renderD2 = RENDER_DISTANCE * RENDER_DISTANCE;

      const drawList = []; // painter's-algorithm list: every visible object, sorted far→near
      // Nearest star this frame (dist/radius ratio) — drives the interior
      // wash. Tracked in the COLLECTION loop, before any projection or
      // off-screen cull: after the core crossing the star is BEHIND the
      // camera and never reaches the draw list, and draw-side tracking made
      // the interior vanish one frame past the core — the whole exit half of
      // every transit rendered as raw space.
      let nearestStarRatio = Infinity;
      const nearestStarCol = [255, 240, 220];
      const nearestStarPos = [0, 0, 0];
      let nearestStarR = 1;
      // Unit vector along current camera velocity (world frame). Used for the
      // velocity-aligned Doppler cosine: cos θ = (source direction · v̂). Camera
      // facing is independent of velocity in vector-translation autopilot, so
      // we can't reuse cosTp (which is computed against camera-forward +Z).
      const vMagFrame = Math.sqrt(velocity[0]*velocity[0] + velocity[1]*velocity[1] + velocity[2]*velocity[2]);
      const vUx = vMagFrame > 1 ? velocity[0] / vMagFrame : 0;
      const vUy = vMagFrame > 1 ? velocity[1] / vMagFrame : 0;
      const vUz = vMagFrame > 1 ? velocity[2] / vMagFrame : 0;
      const haveVel = vMagFrame > 1;
      let nearestThisFrame = Infinity;
      // Reset per-frame nearest-BH tracking — populated below by the chunk loop.
      let nearestBHd2 = Infinity;
      let nearestBHrs = 0;
      let nearestRThisFrame = 0;

      // Scenery density governor. Last frame `bgKeptLast` stars reached the
      // screen while only the fraction `bgKeepFrac` was admitted, so the
      // unthinned count is bgKeptLast / bgKeepFrac and the fraction that lands
      // exactly on budget is budget / that. Correcting for our own thinning is
      // what keeps this from collapsing to the floor as the camera accelerates.
      const bgBudget = BG_SCREEN_BUDGET_PER_MPX * (W * H) / 1e6;
      if (bgKeptLast > 0) {
        const unthinned = bgKeptLast / Math.max(BG_THIN_MIN, bgKeepFrac);
        const want = Math.max(BG_THIN_MIN, Math.min(1, bgBudget / unthinned));
        bgKeepFrac += (want - bgKeepFrac) * Math.min(1, dt / BG_THIN_TAU);
      } else {
        bgKeepFrac = 1;
      }
      const bgThinning = bgKeepFrac < 0.999;
      const bgCut = bgKeepFrac * 65536;          // hash threshold, 16-bit units
      const bgFadeFrom = bgCut * (1 - BG_THIN_FADE);
      let bgKept = 0;

      for (let dx = -N_RADIUS; dx <= N_RADIUS; dx++) {
        for (let dy = -N_RADIUS; dy <= N_RADIUS; dy++) {
          for (let dz = minDz; dz <= maxDz; dz++) {
            const chx = ccx + dx;
            const chy = ccy + dy;
            const chz = ccz + dz;
            const objs = getChunk(chx, chy, chz);
            if (!objs.length) continue;
            for (const obj of objs) {
              const ox = obj.wx - cam[0];
              const oy = obj.wy - cam[1];
              const oz = obj.wz - cam[2];
              const d2 = ox * ox + oy * oy + oz * oz;
              // Scenery stars are excluded: this drives the proximity-based
              // slowdown for manual flight, and background dots are dense
              // enough that one is almost always the nearest object — which
              // would throttle WASD to a crawl everywhere in open space.
              if (!obj.bg && d2 < nearestThisFrame) {
                nearestThisFrame = d2;
                nearestRThisFrame = obj.physRadius || 1e6;
              }
              if (obj.type === 'blackhole' && d2 < nearestBHd2) {
                nearestBHd2 = d2;
                nearestBHrs = obj.physRadius || 1e4;
              }
              // Interior tracking BEFORE every cull — a star being behind the
              // camera must not end its interior wash while we are inside it.
              if (obj.type === 'star' && obj.physRadius > 0 && d2 < obj.physRadius * obj.physRadius * 9) {
                const r = Math.sqrt(d2) / obj.physRadius;
                if (r < nearestStarRatio) {
                  nearestStarRatio = r;
                  nearestStarCol[0] = obj.cr; nearestStarCol[1] = obj.cg; nearestStarCol[2] = obj.cb;
                  nearestStarPos[0] = obj.wx; nearestStarPos[1] = obj.wy; nearestStarPos[2] = obj.wz;
                  nearestStarR = obj.physRadius;
                }
              }
              if (d2 > renderD2) continue;
              // Culled here rather than at draw time so distant scenery costs
              // no projection or aberration work either.
              if (obj.bg && d2 > BG_RENDER_D2) continue;
              // Density thinning happens HERE, ahead of the aberration and
              // projection work, so a star the budget rejects costs one hash
              // and nothing else. `bgU` rides along to the draw so the stars
              // sitting just under the cut can be faded rather than dropped.
              let bgU = 0;
              if (obj.bg && bgThinning) {
                bgU = objHash(obj) & 0xffff;
                if (bgU >= bgCut) continue;
              }
              // Relativistic aberration in the VELOCITY frame (not camera frame).
              // We rotate the source direction around the perpendicular plane to
              // velocity by the aberration angle, then project the aberrated
              // direction into camera-local axes for the screen projection.
              const oMagFull = Math.sqrt(d2) || 1;
              let abX = ox, abY = oy, abZ = oz;
              let cosTvelLocal;
              if (haveVel && beta >= 0.005) {
                const nx = ox / oMagFull, ny = oy / oMagFull, nz = oz / oMagFull;
                cosTvelLocal = nx * vUx + ny * vUy + nz * vUz;
                const cosTp = (cosTvelLocal + beta) / (1 + beta * cosTvelLocal);
                const sinTp = Math.sqrt(Math.max(0, 1 - cosTp * cosTp));
                // perpendicular to v̂ in the rest-frame source direction
                const pX = nx - cosTvelLocal * vUx;
                const pY = ny - cosTvelLocal * vUy;
                const pZ = nz - cosTvelLocal * vUz;
                const pMag = Math.sqrt(pX * pX + pY * pY + pZ * pZ);
                let phx = 0, phy = 0, phz = 0;
                if (pMag > 1e-9) { phx = pX / pMag; phy = pY / pMag; phz = pZ / pMag; }
                const napX = cosTp * vUx + sinTp * phx;
                const napY = cosTp * vUy + sinTp * phy;
                const napZ = cosTp * vUz + sinTp * phz;
                abX = napX * oMagFull;
                abY = napY * oMagFull;
                abZ = napZ * oMagFull;
              } else {
                cosTvelLocal = haveVel ? (ox * vUx + oy * vUy + oz * vUz) / oMagFull : 0;
              }
              // Project aberrated direction into camera-local axes for screen.
              const lx = abX * rx + abY * ry + abZ * rz;
              const ly = -(abX * ux + abY * uy + abZ * uz);
              const aoz = abX * fx + abY * fy + abZ * fz;
              if (aoz <= 1e6) continue;
              const proj = project(lx, ly, aoz);
              if (!proj) continue;
              if (proj.px < -50 || proj.px > W + 50 || proj.py < -50 || proj.py > H + 50) continue;

              const dist = Math.sqrt(d2);
              const depth = 1 - dist / RENDER_DISTANCE; // 0 (far) → 1 (near)

              // Painter's-algorithm depth key: forward-axis distance to the
              // object's *near edge*. Using aoz alone treats huge nebulae as
              // points and lets stars whose centres are technically nearer
              // sort in front of nebulae whose volume actually wraps around
              // them. Subtracting physRadius collapses billboards to their
              // closest face along the line of sight, so a star embedded in
              // a nebula sorts in front of the nebula correctly.
              const r3d = obj.physRadius || 0;
              const sortDepth = Math.max(1, aoz - r3d);
              // Reuse the velocity-frame cosine computed for aberration.
              const cosTvel = cosTvelLocal;
              // Counted here, not at the cull — the budget is about stars that
              // actually land on the canvas, and everything above this point
              // can still reject one.
              if (obj.bg) bgKept++;
              if (obj.type === 'star' || obj.type === 'planet') {
                drawList.push({ type: obj.type, obj, proj, depth, cosTvel, sortDepth, bgU });
              } else if (obj.type === 'nebula') {
                drawList.push({ type: 'nebula', obj, proj, depth, cosTvel, sortDepth });
              } else if (obj.type === 'blackhole') {
                drawList.push({ type: 'blackhole', obj, proj, depth, cosTvel, sortDepth });
              }
            }
          }
        }
      }

      // Feed the governor its measurement for the next frame.
      bgKeptLast = bgKept;

      // Painter's algorithm: depth-sort everything visible so distant objects
      // render before nearer ones (proper occlusion at all distances).
      // Sort by forward-axis depth (near edge), descending — far first, near last.
      drawList.sort((a, b) => b.sortDepth - a.sortDepth);
      // Relativistic Doppler colour tint. cosTvel = (line-of-sight · v̂) so a
      // body behind the velocity vector redshifts even if it's centred on
      // screen, regardless of where the camera is facing.
      function applyDopplerTint(px, py, radius, cosTvel) {
        if (beta <= 0.02 || radius < 1) return;
        const gamma = 1 / Math.sqrt(1 - beta * beta);
        const D = gamma * (1 + beta * cosTvel);
        const logD = Math.log(D);
        if (Math.abs(logD) < 0.03) return;
        const ta = Math.min(0.75, Math.abs(logD) * 1.2);
        const tr = D > 1 ?  90 : 255;
        const tg = D > 1 ? 150 : 130;
        const tb = D > 1 ? 255 :  60;
        ctx.globalCompositeOperation = 'multiply';
        ctx.fillStyle = `rgba(${tr},${tg},${tb},${ta.toFixed(2)})`;
        ctx.beginPath();
        ctx.arc(px, py, radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalCompositeOperation = 'source-over';
      }
      // The 2d body canvas sits ABOVE the GL interior wash, so background
      // planets/nebulae/black holes would paint on top of a star's interior
      // as ghosts. Dim every 2d draw by the interior fade. Set per item —
      // several body renderers reset globalAlpha internally.
      // Matches the interior wash band exactly — dimming background bodies
      // while still outside the star was part of the same haze.
      const bodyAlpha2d = starGL ? Math.max(0, 1 - Math.min(1, (1.02 - Math.min(1.02, nearestStarRatio)) / 0.14)) : 1;
      for (let _idx = 0; _idx < drawList.length; _idx++) {
        ctx.globalAlpha = bodyAlpha2d;
        const _item = drawList[_idx];
        const obj = _item.obj;
        const proj = _item.proj;
        const depth = _item.depth;
        const cosTvel = _item.cosTvel;

        if (_item.type === 'star') {
          const angRad = obj.physRadius / 1e15 * proj.k / gammaTime;
          // 3D impostor path: any star bigger than a couple of pixels becomes
          // a shaded sphere on the GL layer — limb, granulation, corona —
          // replacing both 2d tiers below (which remain as the no-WebGL
          // fallback). Colour is Doppler-shifted here in JS, unwhitened:
          // resolved discs keep their real spectral colour.
          if (starGL && starGL.hasBodies() && angRad > 2) {
            let br = obj.cr, bg2 = obj.cg, bb2 = obj.cb;
            if (beta > 0.01) {
              const gamma = 1 / Math.sqrt(1 - beta * beta);
              const D = gamma * (1 + beta * cosTvel);
              const dop = dopplerColor(br, bg2, bb2, D);
              br = (dop >> 16) & 0xff; bg2 = (dop >> 8) & 0xff; bb2 = dop & 0xff;
            }
            starGL.pushBody(proj.px, proj.py, angRad, br, bg2, bb2, ((objHash(obj) & 0xffff) / 0xffff));
            // (interior tracking happens in the collection loop, pre-cull)
          } else if (angRad > 6) {
            const tex = getStarTexture(obj);
            ctx.drawImage(tex, proj.px - angRad, proj.py - angRad, angRad * 2, angRad * 2);
            applyDopplerTint(proj.px, proj.py, angRad, cosTvel);
            if (angRad > 18) {
              const rng = mulberry32(objHash(obj) ^ 0xF1A4E5);
              const rotPeriod = 8 + rng() * 18;
              const rotPhase = tAnim * (2 * Math.PI / rotPeriod);
              const regionCount = 3 + Math.floor(rng() * 4);
              for (let i = 0; i < regionCount; i++) {
                const lat = (rng() - 0.5) * Math.PI * 0.75;
                const baseLon = rng() * Math.PI * 2;
                const flarePeriod = 5 + rng() * 12;
                const flarePhase = rng() * Math.PI * 2;
                const sz = 0.07 + rng() * 0.15;
                const lon = baseLon + rotPhase;
                const cosLon = Math.cos(lon);
                if (cosLon <= -0.1) continue;
                const cosLat = Math.cos(lat);
                const sx = proj.px + Math.sin(lon) * cosLat * angRad;
                const sy = proj.py + Math.sin(lat) * angRad;
                const limbF = Math.max(0, cosLon);
                const pulse = 0.5 + 0.5 * Math.sin(tAnim * (2 * Math.PI / flarePeriod) + flarePhase);
                const intensity = pulse * (0.3 + 0.7 * limbF);
                const flareR = angRad * sz * (0.7 + pulse * 0.6);
                const grad = ctx.createRadialGradient(sx, sy, 0, sx, sy, flareR);
                grad.addColorStop(0, `rgba(255,210,120,${(0.85 * intensity).toFixed(2)})`);
                grad.addColorStop(0.5, `rgba(255,130,60,${(0.4 * intensity).toFixed(2)})`);
                grad.addColorStop(1, 'rgba(255,60,30,0)');
                ctx.fillStyle = grad;
                ctx.beginPath(); ctx.arc(sx, sy, flareR, 0, Math.PI * 2); ctx.fill();
              }
              const cmePeriod = 18 + (rng() * 25);
              const cmePhase = rng() * cmePeriod;
              const tCycle = ((tAnim + cmePhase) % cmePeriod) / cmePeriod;
              if (tCycle < 0.18) {
                const burst = Math.sin(tCycle / 0.18 * Math.PI);
                const eAng = (rng() * Math.PI * 2) + rotPhase * 0.5;
                const ex = proj.px + Math.cos(eAng) * angRad;
                const ey = proj.py + Math.sin(eAng) * angRad;
                const cmeR = angRad * (0.3 + burst * 0.6);
                const cmeG = ctx.createRadialGradient(ex, ey, 0, ex, ey, cmeR);
                cmeG.addColorStop(0, `rgba(255,230,170,${(0.7 * burst).toFixed(2)})`);
                cmeG.addColorStop(0.5, `rgba(255,120,60,${(0.35 * burst).toFixed(2)})`);
                cmeG.addColorStop(1, 'rgba(255,60,30,0)');
                ctx.fillStyle = cmeG;
                ctx.beginPath(); ctx.arc(ex, ey, cmeR, 0, Math.PI * 2); ctx.fill();
              }
            }
            const haloPulse = 1 + 0.06 * Math.sin(tAnim * 0.7 + (objHash(obj) & 0xff) / 255 * Math.PI * 2);
            const halo = ctx.createRadialGradient(proj.px, proj.py, angRad, proj.px, proj.py, angRad * 3.5 * haloPulse);
            halo.addColorStop(0, `rgba(${obj.cr},${obj.cg},${obj.cb},0.45)`);
            halo.addColorStop(1, `rgba(${obj.cr},${obj.cg},${obj.cb},0)`);
            ctx.fillStyle = halo;
            ctx.beginPath(); ctx.arc(proj.px, proj.py, angRad * 3.5 * haloPulse, 0, Math.PI * 2); ctx.fill();
          } else if (angRad > 2) {
            const disc = ctx.createRadialGradient(proj.px, proj.py, 0, proj.px, proj.py, angRad);
            disc.addColorStop(0,   `rgba(${Math.min(255, obj.cr + 60)},${Math.min(255, obj.cg + 60)},${Math.min(255, obj.cb + 60)},1)`);
            disc.addColorStop(0.85, `rgba(${obj.cr},${obj.cg},${obj.cb},0.95)`);
            disc.addColorStop(1,   `rgba(${obj.cr},${obj.cg},${obj.cb},0)`);
            ctx.fillStyle = disc;
            ctx.beginPath(); ctx.arc(proj.px, proj.py, angRad, 0, Math.PI * 2); ctx.fill();
            const halo = ctx.createRadialGradient(proj.px, proj.py, angRad, proj.px, proj.py, angRad * 3);
            halo.addColorStop(0, `rgba(${obj.cr},${obj.cg},${obj.cb},0.35)`);
            halo.addColorStop(1, `rgba(${obj.cr},${obj.cg},${obj.cb},0)`);
            ctx.fillStyle = halo;
            ctx.beginPath(); ctx.arc(proj.px, proj.py, angRad * 3, 0, Math.PI * 2); ctx.fill();
          } else {
            // Dot size scales with angRad up to the gradient threshold so the
            // transition isn't a visible jump from "small dot" to "blob".
            const size = Math.max(STAR_MIN_PX, Math.max(depth * 3.4 * obj.sizeMul, angRad * 2));
            let a = Math.pow(obj.bri * (STAR_DEPTH_FLOOR + depth * (1 - STAR_DEPTH_FLOOR)), STAR_GAMMA);
            if (obj.bg) {
              // Ramp scenery in across the fade band so nothing pops as the
              // camera crosses the scenery cull radius.
              const f = (depth - BG_FADE_DEPTH) / BG_FADE_BAND;
              a *= f < 0 ? 0 : f > 1 ? 1 : f;
              // ...and out across the top of the density-budget window, so a
              // drifting keep fraction dissolves stars instead of blinking
              // them. The band is a fraction of the window, so it scales with
              // the cut rather than being a fixed number of hash values.
              if (bgThinning && _item.bgU > bgFadeFrom) {
                a *= 1 - (_item.bgU - bgFadeFrom) / (bgCut - bgFadeFrom);
              }
            }
            let cr = obj.cr, cg = obj.cg, cb = obj.cb;
            if (beta > 0.01) {
              const gamma = 1 / Math.sqrt(1 - beta * beta);
              const D = gamma * (1 + beta * cosTvel);
              const dop = dopplerColor(cr, cg, cb, D);
              cr = (dop >> 16) & 0xff;
              cg = (dop >> 8) & 0xff;
              cb = dop & 0xff;
              // Bolometric relativistic beaming: photon energy × bunching × time
              // × solid-angle scales as D⁴ (proper photon flux per unit observer
              // time). Floor at 0.3 so redshifted sources remain visibly red,
              // cap at 16 so blueshifted bodies brighten dramatically but
              // don't whiteout the entire canvas.
              const beam = Math.max(0.3, Math.min(16, D * D * D * D));
              a = Math.min(1, a * beam);
            }
            // Desaturate toward white AFTER the Doppler shift. Cruise sits at
            // β ≈ 0.9996, where the blueshift is strong enough to turn the
            // whole sky cyan — whitening first would just get overwritten.
            // Applying it last means STAR_WHITEN is a hard ceiling on
            // saturation at any speed, while the surviving (1 - STAR_WHITEN)
            // fraction still carries a hint of the shift.
            cr = (cr + (255 - cr) * STAR_WHITEN) | 0;
            cg = (cg + (255 - cg) * STAR_WHITEN) | 0;
            cb = (cb + (255 - cb) * STAR_WHITEN) | 0;
            // Scintillation. Phase and rate come from the object hash so a
            // given star always twinkles identically at the same coordinate —
            // the field stays deterministic across visitors and reloads.
            {
              const th = objHash(obj);
              const twPhase = (th & 0xff) / 255 * Math.PI * 2;
              const twRate  = STAR_TWINKLE_HZ * (0.6 + ((th >> 8) & 0xff) / 255);
              // Wall-clock, NOT tAnim. tAnim is scaled by gammaTime, which at
              // cruise reaches 1e8 — driving the phase from it made every star
              // strobe. Scintillation is an atmospheric/observer effect and has
              // no business being time-dilated by the camera's velocity.
              a *= 1 - STAR_TWINKLE * (0.5 + 0.5 * Math.sin(tAnimSec * twRate + twPhase));
            }
            drawStar(proj.px, proj.py, cr, cg, cb, a, size);
          }

        } else if (_item.type === 'planet') {
          const rad = obj.physRadius / 1e15 * proj.k / gammaTime;
          if (rad < 0.6) {
            // Dot sized at `rad * 2` matches the gradient-disc diameter at
            // the next LOD tier (rad=0.6) — no visible jump from dot to blob.
            const dotA = Math.max(0.25, 0.6 * depth);
            drawStar(proj.px, proj.py, obj.cr, obj.cg, obj.cb, dotA, Math.max(0.7, rad * 2));
          } else if (rad < 6) {
            const visAlpha = Math.min(1, 0.4 + depth);
            const grad = ctx.createRadialGradient(proj.px - rad * 0.35, proj.py - rad * 0.35, 0, proj.px, proj.py, rad);
            grad.addColorStop(0, `rgba(${Math.min(255, obj.cr + 30)},${Math.min(255, obj.cg + 30)},${Math.min(255, obj.cb + 30)},${visAlpha.toFixed(2)})`);
            grad.addColorStop(0.75, `rgba(${obj.cr},${obj.cg},${obj.cb},${visAlpha.toFixed(2)})`);
            grad.addColorStop(1, `rgba(${(obj.cr * 0.5) | 0},${(obj.cg * 0.5) | 0},${(obj.cb * 0.5) | 0},${visAlpha.toFixed(2)})`);
            ctx.fillStyle = grad;
            ctx.beginPath(); ctx.arc(proj.px, proj.py, rad, 0, Math.PI * 2); ctx.fill();
          } else {
            // ===== ring, far half =====
            // A ring only reads as 3D if the planet occludes the half that
            // passes BEHIND it. Canvas has no depth buffer, so the ring is
            // split: the far arc is painted first, the body covers its middle,
            // and the near arc goes on top afterwards. Drawing the full
            // ellipse in one pass (the old code) put the whole ring in front,
            // which is why it looked pasted on rather than encircling.
            // Canvas ellipse angles: 0 = +x, sweeping through +y (screen
            // DOWN) for 0..π. So π..2π is the top of the ellipse = far side.
            if (obj.hasRing && rad > 2) drawPlanetRing(obj, proj, rad, depth, 'far');
            const tex = getPlanetTexture(obj);
            ctx.drawImage(tex, proj.px - rad, proj.py - rad, rad * 2, rad * 2);
            applyDopplerTint(proj.px, proj.py, rad, cosTvel);
            const hasAtmos = obj.kind === 'ocean' || obj.kind === 'gas_giant' || obj.kind === 'ice_giant' || obj.kind === 'shrouded';
            // Atmospheric glow (limb scattering) — stronger and more saturated
            // than the previous gentle limb. Two-stop gradient with a tight
            // bright rim then a wider outer haze.
            if (rad > 15 && hasAtmos) {
              const ar = Math.min(255, obj.cr + 80);
              const ag = Math.min(255, obj.cg + 80);
              const ab = Math.min(255, obj.cb + 80);
              const rim = ctx.createRadialGradient(proj.px, proj.py, rad * 0.96, proj.px, proj.py, rad * 1.30);
              rim.addColorStop(0,   `rgba(${ar},${ag},${ab},0)`);
              rim.addColorStop(0.20,`rgba(${ar},${ag},${ab},0.65)`);
              rim.addColorStop(0.50,`rgba(${ar},${ag},${ab},0.25)`);
              rim.addColorStop(1,   `rgba(${ar},${ag},${ab},0)`);
              ctx.fillStyle = rim;
              ctx.beginPath(); ctx.arc(proj.px, proj.py, rad * 1.30, 0, Math.PI * 2); ctx.fill();
            }
            // Day/night terminator — soft shadow on the side opposite the star
            // (we don't track a real light source so just use a fixed phase
            // derived from objHash for variety).
            if (rad > 30) {
              const phaseR = mulberry32(objHash(obj) + 0xab);
              const phase = phaseR() * Math.PI * 2;
              const sx = Math.cos(phase) * rad * 0.55;
              const sy = Math.sin(phase) * rad * 0.55;
              const shade = ctx.createRadialGradient(proj.px - sx, proj.py - sy, rad * 0.20, proj.px - sx, proj.py - sy, rad * 1.10);
              shade.addColorStop(0, 'rgba(0,0,0,0)');
              shade.addColorStop(0.65, 'rgba(0,0,0,0)');
              shade.addColorStop(1, 'rgba(0,0,0,0.55)');
              ctx.save();
              ctx.beginPath(); ctx.arc(proj.px, proj.py, rad, 0, Math.PI * 2); ctx.clip();
              ctx.fillStyle = shade;
              ctx.fillRect(proj.px - rad, proj.py - rad, rad * 2, rad * 2);
              ctx.restore();
            }
            // Gas-giant storm spots — a few oval cyclones at different
            // latitudes, animated by tAnim for slow drift.
            if (rad > 30 && obj.kind === 'gas_giant') {
              const stormR = mulberry32(objHash(obj) + 0xcd);
              const stormCount = 2 + Math.floor(stormR() * 3);
              for (let s = 0; s < stormCount; s++) {
                const lat = (stormR() - 0.5) * 1.4;
                const lon = stormR() * Math.PI * 2 + tAnim * 0.02 * (s + 1);
                const sx = Math.sin(lon) * Math.cos(lat) * rad * 0.85;
                const sy = Math.sin(lat) * rad * 0.85;
                if (sx * sx + sy * sy > rad * rad * 0.72) continue;
                const sRad = rad * (0.08 + stormR() * 0.10);
                const tintR = Math.min(255, obj.cr + (stormR() < 0.5 ? -50 : 50));
                const tintG = Math.min(255, obj.cg + (stormR() < 0.5 ? -30 : 20));
                const tintB = Math.min(255, obj.cb + (stormR() < 0.5 ? -20 : 30));
                const storm = ctx.createRadialGradient(proj.px + sx, proj.py + sy, 0, proj.px + sx, proj.py + sy, sRad);
                storm.addColorStop(0, `rgba(${tintR},${tintG},${tintB},0.7)`);
                storm.addColorStop(0.6, `rgba(${tintR},${tintG},${tintB},0.3)`);
                storm.addColorStop(1, `rgba(${tintR},${tintG},${tintB},0)`);
                ctx.fillStyle = storm;
                ctx.beginPath(); ctx.ellipse(proj.px + sx, proj.py + sy, sRad, sRad * 0.55, lon, 0, Math.PI * 2); ctx.fill();
              }
            }
            // Specular highlight on ocean worlds — a small bright crescent
            // where a sun would reflect off the water.
            if (rad > 25 && obj.kind === 'ocean') {
              const phaseR2 = mulberry32(objHash(obj) + 0x99);
              const phase = phaseR2() * Math.PI * 2;
              const hx = Math.cos(phase) * rad * 0.45;
              const hy = Math.sin(phase) * rad * 0.45;
              const spec = ctx.createRadialGradient(proj.px + hx, proj.py + hy, 0, proj.px + hx, proj.py + hy, rad * 0.35);
              spec.addColorStop(0, 'rgba(255,255,255,0.65)');
              spec.addColorStop(0.4, 'rgba(255,255,255,0.18)');
              spec.addColorStop(1, 'rgba(255,255,255,0)');
              ctx.save();
              ctx.beginPath(); ctx.arc(proj.px, proj.py, rad, 0, Math.PI * 2); ctx.clip();
              ctx.fillStyle = spec;
              ctx.fillRect(proj.px - rad, proj.py - rad, rad * 2, rad * 2);
              ctx.restore();
            }
            // Polar aurora — green/red bands on terrestrial planets, animated.
            if (rad > 35 && (obj.kind === 'ocean' || obj.kind === 'iceworld' || obj.kind === 'shrouded')) {
              const auroraR = mulberry32(objHash(obj) + 0xde);
              if (auroraR() > 0.35) {
                const ag = 100 + auroraR() * 155;
                const ab = 180 + auroraR() * 75;
                const auroraPhase = tAnim * 0.4 + auroraR() * Math.PI * 2;
                const flick = 0.4 + 0.3 * Math.sin(auroraPhase);
                ctx.save();
                ctx.beginPath(); ctx.arc(proj.px, proj.py, rad, 0, Math.PI * 2); ctx.clip();
                ctx.strokeStyle = `rgba(80,${ag | 0},${ab | 0},${flick.toFixed(2)})`;
                ctx.lineWidth = Math.max(0.6, rad * 0.04);
                // North polar ring
                ctx.beginPath(); ctx.ellipse(proj.px, proj.py - rad * 0.7, rad * 0.55, rad * 0.18, 0, 0, Math.PI * 2); ctx.stroke();
                // South polar ring
                ctx.beginPath(); ctx.ellipse(proj.px, proj.py + rad * 0.7, rad * 0.55, rad * 0.18, 0, 0, Math.PI * 2); ctx.stroke();
                ctx.restore();
              }
            }
            // ===== ring, near half =====
            // Painted last so it crosses in front of the body, completing the
            // encirclement begun by the far half above.
            if (obj.hasRing && rad > 2) drawPlanetRing(obj, proj, rad, depth, 'near');
          }

        } else if (_item.type === 'nebula') {
          const rad = Math.min(4000, obj.physRadius / 1e15 * proj.k / gammaTime);
          if (rad < 8) continue;
          ctx.globalCompositeOperation = 'lighter';
          const grad = ctx.createRadialGradient(proj.px, proj.py, 0, proj.px, proj.py, rad);
          grad.addColorStop(0,   `rgba(${obj.cr},${obj.cg},${obj.cb},0.22)`);
          grad.addColorStop(0.4, `rgba(${obj.cr},${obj.cg},${obj.cb},0.07)`);
          grad.addColorStop(1,   `rgba(${obj.cr},${obj.cg},${obj.cb},0)`);
          ctx.fillStyle = grad;
          ctx.fillRect(proj.px - rad, proj.py - rad, rad * 2, rad * 2);
          if (rad > 120) {
            const r = mulberry32(objHash(obj));
            const subs = 4 + Math.floor(Math.min(10, rad / 80));
            for (let s = 0; s < subs; s++) {
              const ang = r() * Math.PI * 2;
              const dist = r() * rad * 0.6;
              const sx = proj.px + Math.cos(ang) * dist;
              const sy = proj.py + Math.sin(ang) * dist;
              const subR = rad * (0.18 + r() * 0.4);
              const shift = 50;
              const cr = Math.max(0, Math.min(255, (obj.cr + (r() - 0.5) * shift) | 0));
              const cg = Math.max(0, Math.min(255, (obj.cg + (r() - 0.5) * shift) | 0));
              const cb = Math.max(0, Math.min(255, (obj.cb + (r() - 0.5) * shift) | 0));
              const g2 = ctx.createRadialGradient(sx, sy, 0, sx, sy, subR);
              g2.addColorStop(0, `rgba(${cr},${cg},${cb},0.16)`);
              g2.addColorStop(1, `rgba(${cr},${cg},${cb},0)`);
              ctx.fillStyle = g2;
              ctx.fillRect(sx - subR, sy - subR, subR * 2, subR * 2);
            }
          }
          if (rad > 600) {
            const r = mulberry32(objHash(obj) ^ 0xF11AFF);
            const wisps = 6 + Math.floor(r() * 6);
            ctx.strokeStyle = `rgba(${Math.min(255, obj.cr + 60)},${Math.min(255, obj.cg + 60)},${Math.min(255, obj.cb + 60)},0.18)`;
            ctx.lineWidth = 1.2;
            for (let w = 0; w < wisps; w++) {
              const ang = r() * Math.PI * 2;
              const len = rad * (0.35 + r() * 0.55);
              const startR = r() * rad * 0.3;
              const sx = proj.px + Math.cos(ang) * startR;
              const sy = proj.py + Math.sin(ang) * startR;
              const ex = sx + Math.cos(ang) * len;
              const ey = sy + Math.sin(ang) * len;
              const mx = (sx + ex) / 2 + (r() - 0.5) * len * 0.3;
              const my = (sy + ey) / 2 + (r() - 0.5) * len * 0.3;
              ctx.beginPath();
              ctx.moveTo(sx, sy);
              ctx.quadraticCurveTo(mx, my, ex, ey);
              ctx.stroke();
            }
          }
          ctx.globalCompositeOperation = 'source-over';
          // Nebulae are diffuse emission sources — they Doppler-shift too.
          applyDopplerTint(proj.px, proj.py, rad, cosTvel);

        } else if (_item.type === 'blackhole') {
          const rEH = Math.min(800, obj.physRadius / 1e15 * proj.k / gammaTime);
          if (rEH < 2) continue;
          const rHalo = rEH * 6;
          const halo = ctx.createRadialGradient(proj.px, proj.py, rEH * 0.5, proj.px, proj.py, rHalo);
          halo.addColorStop(0,   'rgba(255,180,90,0.5)');
          halo.addColorStop(0.2, 'rgba(255,120,40,0.2)');
          halo.addColorStop(0.5, 'rgba(120,60,200,0.08)');
          halo.addColorStop(1,   'rgba(0,0,0,0)');
          ctx.fillStyle = halo;
          ctx.fillRect(proj.px - rHalo, proj.py - rHalo, rHalo * 2, rHalo * 2);
          if (rEH < 10) {
            ctx.strokeStyle = 'rgba(255,210,140,0.85)';
            ctx.lineWidth = Math.max(1, rEH * 0.22);
            ctx.beginPath(); ctx.arc(proj.px, proj.py, rEH * 1.5, 0, Math.PI * 2); ctx.stroke();
          } else {
            const r = mulberry32(objHash(obj));
            const tilt = (r() - 0.5) * 0.7 + 0.4;
            const rotSpeed = 0.4 + r() * 0.45;
            const orbitPhase = tAnim * rotSpeed;
            ctx.save();
            ctx.translate(proj.px, proj.py);
            ctx.rotate(tilt);
            const jetLen = rEH * 12;
            const jetW = rEH * 0.65;
            for (const dyJet of [-jetLen, jetLen]) {
              const g = ctx.createLinearGradient(0, 0, 0, dyJet);
              g.addColorStop(0,   'rgba(200,225,255,0.55)');
              g.addColorStop(0.25,'rgba(150,190,255,0.30)');
              g.addColorStop(0.6, 'rgba(120,165,255,0.10)');
              g.addColorStop(1,   'rgba(120,165,255,0)');
              ctx.fillStyle = g;
              ctx.beginPath();
              ctx.moveTo(-rEH * 0.18, 0);
              ctx.lineTo(-jetW, dyJet);
              ctx.lineTo(jetW, dyJet);
              ctx.lineTo(rEH * 0.18, 0);
              ctx.closePath();
              ctx.fill();
            }
            const bands = 14;
            for (let b = 0; b < bands; b++) {
              const t = b / (bands - 1);
              const rBand = rEH * (1.4 + t * 2.4);
              const minor = rBand * 0.18;
              const lw = Math.max(0.8, rEH * 0.14);
              const innerR = 255, innerG = 240 - t * 110, innerB = 180 - t * 140;
              const baseA = 0.75 - t * 0.45;
              ctx.strokeStyle = `rgba(${Math.min(255, innerR + 0)|0},${Math.min(255, innerG + 30)|0},${Math.min(255, innerB + 60)|0},${(baseA * 1.0).toFixed(2)})`;
              ctx.lineWidth = lw * 1.1;
              ctx.beginPath();
              ctx.ellipse(0, 0, rBand, minor, 0, 0, Math.PI);
              ctx.stroke();
              ctx.strokeStyle = `rgba(${innerR|0},${(innerG * 0.6)|0},${(innerB * 0.4)|0},${(baseA * 0.35).toFixed(2)})`;
              ctx.lineWidth = lw * 0.9;
              ctx.beginPath();
              ctx.ellipse(0, 0, rBand, minor, 0, Math.PI, Math.PI * 2);
              ctx.stroke();
              const sectorPhase = orbitPhase * (1 + b * 0.2);
              const arcSpan = 0.9;
              ctx.strokeStyle = `rgba(255,250,210,${(baseA * 0.9).toFixed(2)})`;
              ctx.lineWidth = lw * 1.3;
              ctx.beginPath();
              ctx.ellipse(0, 0, rBand, minor, 0, sectorPhase - arcSpan / 2, sectorPhase + arcSpan / 2);
              ctx.stroke();
            }
            ctx.restore();
            ctx.strokeStyle = 'rgba(255,250,205,0.95)';
            ctx.lineWidth = Math.max(0.8, rEH * 0.07);
            ctx.beginPath(); ctx.arc(proj.px, proj.py, rEH * 1.5, 0, Math.PI * 2); ctx.stroke();
            ctx.strokeStyle = 'rgba(255,230,170,0.45)';
            ctx.lineWidth = Math.max(0.4, rEH * 0.03);
            ctx.beginPath(); ctx.arc(proj.px, proj.py, rEH * 1.22, 0, Math.PI * 2); ctx.stroke();
          }
          ctx.fillStyle = '#000';
          ctx.beginPath(); ctx.arc(proj.px, proj.py, rEH, 0, Math.PI * 2); ctx.fill();
        }
      }

      ctx.globalAlpha = 1;   // undo the interior body-dim for later 2d draws
      // One upload + one draw call for every star dot batched this frame.
      if (starGL) {
        starGL.flush(dark, DOT_GLOW_SCALE, STAR_HALO_ALPHA);
        starGL.flushBodies(tAnimSec);
        // Interior wash — INSIDE the surface only (1.02R → 0.88R). This is a
        // fullscreen overlay, so any fade band reaching outside the star hazes
        // the entire view, sky included, while the star is still just a disc
        // ahead: it read as flying through mist. It used to start at 1.6R,
        // which meant ~67% opaque fog at 1.2R — well outside the body.
        //
        // Nothing is lost by starting at the surface: on approach the impostor
        // quad already fills the screen with photosphere (it spans 2.6 stellar
        // radii, so past ~2.6R out it covers everything), and the wash only
        // has to take over once the camera is inside — and carry the exit
        // half alone, where the star sits behind the camera and the impostor
        // is no longer drawn at all. Advection comes from SIGNED progress
        // along the motion so the convection keeps streaming past throughout.
        if (nearestStarRatio < 1.02) {
          const fade = Math.min(1, (1.02 - nearestStarRatio) / 0.14);
          const depthFrac = Math.max(0, Math.min(1, nearestStarRatio)); // 0 core → 1 surface
          let progress = 0;
          const vm = Math.sqrt(velocity[0]*velocity[0] + velocity[1]*velocity[1] + velocity[2]*velocity[2]);
          if (vm > 1) {
            progress = ((cam[0] - nearestStarPos[0]) * velocity[0] +
                        (cam[1] - nearestStarPos[1]) * velocity[1] +
                        (cam[2] - nearestStarPos[2]) * velocity[2]) / (vm * nearestStarR);
          }
          starGL.interior(tAnimSec, nearestStarCol[0], nearestStarCol[1], nearestStarCol[2], depthFrac, fade, progress * 2.2, progress * 0.7);
        }
      }

      lastNearestD = nearestThisFrame === Infinity ? Infinity : Math.sqrt(nearestThisFrame);
      lastNearestR = nearestRThisFrame;
      lastNearestBHDist = nearestBHd2 === Infinity ? Infinity : Math.sqrt(nearestBHd2);
      lastNearestBHRs = nearestBHrs;
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);

    // Save on unload too
    window.addEventListener('beforeunload', savePosition);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
