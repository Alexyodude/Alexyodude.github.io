    // total transition feel = this sweep + the view's easing behind it.
    const VEL_TURN_RATE = 50;
    // Transit tour: how many radii past the far surface before the handoff to
    // the next target fires. Big enough that the star shrinks behind you
    // before the view banks away.
    const TRANSIT_EXIT_R = 8;
    const TRANSIT_CROSS_S = 3.5;  // interior crossing ≈ 2×this seconds
    const TRANSIT_RAMP_S = 3.0;   // approach/exit ramp gentleness (τ, seconds)
    let autopilotTransitDone = false; // set once a transit has crossed and cleared the far side
    // Upward speed slew cap, decades per second. 1.5 → a 3-decade climb
