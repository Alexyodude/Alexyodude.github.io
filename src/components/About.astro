---
import timeline from '../content/timeline.json';

type Entry = {
  date: string;
  title: string;
  description: string;
};

// Timeline JSON is newest-first; reverse so it reads past → future left to right.
const entries = (timeline as Entry[]).slice().reverse();
---

<section class="px-6 py-16 max-w-3xl mx-auto">
  <ol id="timeline-row" class="timeline-row flex gap-3 pb-2 relative" role="list">
    <span class="timeline-track" aria-hidden="true"></span>
    <span class="timeline-progress" aria-hidden="true"></span>
    <span class="timeline-pulse" aria-hidden="true"></span>
    {entries.map((e) => (
      <li class="relative shrink-0 w-36 pt-5">
        <span class="absolute left-1/2 top-2 -translate-x-1/2 h-3 w-3 rounded-full bg-accent ring-4 ring-bg"></span>
        <div class="text-[10px] uppercase tracking-widest text-muted text-center">{e.date}</div>
        <div class="mt-1 text-sm font-semibold leading-tight text-center">{e.title}</div>
      </li>
    ))}
  </ol>

  <h2 class="mt-12 text-sm uppercase tracking-widest text-muted">About</h2>
  <p class="mt-6 text-base md:text-lg leading-relaxed">
    Grew up between <span class="text-fg">Vancouver</span>,
    <span class="text-fg">Boston</span>, and
    <span class="text-fg">Seoul</span>: elementary school in Vancouver,
    middle school in Boston, then an international high school in South Korea.
    Studied <span class="text-fg">Theoretical Physics</span> at
    <span class="text-fg">King's College London</span> (BSc and MSc). Completed military service 2024–2025.
  </p>
</section>

<style>
  .timeline-row {
    overflow-x: auto;
    cursor: grab;
    scrollbar-width: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .timeline-row::-webkit-scrollbar { display: none; }
  .timeline-row.dragging { cursor: grabbing; }
  /* The dim base line — runs all the way across, faded at the ends. */
  .timeline-track {
    position: absolute;
    left: 0; right: 0;
    top: 12px;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--color-border) 6%,
      var(--color-border) 94%,
      transparent
    );
    pointer-events: none;
  }
  /* Glowing progress overlay — expands left→right until it reaches the present,
     then briefly holds and loops. The gradient gives it depth (faint at the
     past end, bright accent at the leading edge). */
  .timeline-progress {
    position: absolute;
    left: 0;
    top: 12px;
    height: 2px;
    margin-top: -1px;
    width: 0;
    background: linear-gradient(
      to right,
      transparent,
      color-mix(in srgb, var(--color-accent) 35%, transparent) 30%,
      color-mix(in srgb, var(--color-accent) 80%, transparent) 80%,
      var(--color-accent)
    );
    box-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 60%, transparent);
    pointer-events: none;
    animation: timelineProgress 14s ease-in-out infinite;
  }
  .timeline-pulse {
    position: absolute;
    top: 12px;
    left: 0;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    margin-left: -5px;
    border-radius: 9999px;
    background: var(--color-accent);
    box-shadow:
      0 0 8px var(--color-accent),
      0 0 18px color-mix(in srgb, var(--color-accent) 70%, transparent),
      0 0 30px color-mix(in srgb, var(--color-accent) 40%, transparent);
    pointer-events: none;
    animation: timelineMove 14s ease-in-out infinite, timelinePulse 1.4s ease-in-out infinite;
  }
  @keyframes timelineMove {
    0%   { left: 0%; }
    80%  { left: 100%; }
    90%  { left: 100%; }   /* hold at the present */
    100% { left: 0%; opacity: 0; }
  }
  @keyframes timelineProgress {
    0%   { width: 0; }
    80%  { width: 100%; }
    90%  { width: 100%; }  /* hold at the present */
    100% { width: 0; opacity: 0; }
  }
  @keyframes timelinePulse {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50%      { opacity: 1;    transform: scale(1.8); }
  }
</style>

<script is:inline>
  (function () {
    function init() {
      const el = document.getElementById('timeline-row');
      if (!el) return;
      // Default to the right end so the most recent entry is visible on load.
      const scrollToEnd = () => { el.scrollLeft = el.scrollWidth - el.clientWidth; };
      scrollToEnd();
      window.addEventListener('load', scrollToEnd);
      let isDown = false;
      let startX = 0;
      let startScroll = 0;
      let moved = false;
      const start = (clientX) => {
        isDown = true;
        moved = false;
        startX = clientX;
        startScroll = el.scrollLeft;
        el.classList.add('dragging');
      };
      const move = (clientX, e) => {
        if (!isDown) return;
        const dx = clientX - startX;
        if (Math.abs(dx) > 3) moved = true;
        if (e && moved) e.preventDefault();
        el.scrollLeft = startScroll - dx;
      };
      const end = () => {
        isDown = false;
        el.classList.remove('dragging');
      };
      el.addEventListener('mousedown', (e) => start(e.clientX));
      window.addEventListener('mousemove', (e) => move(e.clientX, e));
      window.addEventListener('mouseup', end);
      el.addEventListener('mouseleave', () => { if (isDown) end(); });
      el.addEventListener('touchstart', (e) => start(e.touches[0].clientX), { passive: true });
      el.addEventListener('touchmove', (e) => move(e.touches[0].clientX, e), { passive: false });
      el.addEventListener('touchend', end);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
