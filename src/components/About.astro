---
import timeline from '../content/timeline.json';

type Entry = {
  date: string;
  title: string;
  description: string;
};

const entries = timeline as Entry[];
---

<section class="px-6 py-16 max-w-3xl mx-auto">
  <ol class="timeline-row flex gap-3 overflow-x-auto pb-2 relative">
    <span class="absolute left-0 right-0 top-3 h-px bg-border" aria-hidden="true"></span>
    {entries.map((e) => (
      <li class="relative shrink-0 w-36 pt-5">
        <span class="absolute left-1/2 top-2 -translate-x-1/2 h-3 w-3 rounded-full bg-accent ring-4 ring-bg"></span>
        <div class="text-[10px] uppercase tracking-widest text-muted text-center">{e.date}</div>
        <div class="mt-1 text-sm font-semibold leading-tight text-center">{e.title}</div>
      </li>
    ))}
  </ol>

  <h2 class="mt-12 text-sm uppercase tracking-widest text-muted">About</h2>
  <p class="mt-6 text-base md:text-lg leading-relaxed">
    Grew up between <span class="text-fg">Vancouver</span>,
    <span class="text-fg">Boston</span>, and
    <span class="text-fg">Seoul</span>: elementary school in Vancouver,
    middle school in Boston, then an international high school in South Korea.
    Studied <span class="text-fg">Theoretical Physics</span> at
    <span class="text-fg">King's College London</span> (BSc and MSc). Completed military service 2024–2025.
  </p>
</section>

<style>
  .timeline-row { scrollbar-width: none; }
  .timeline-row::-webkit-scrollbar { display: none; }
</style>
