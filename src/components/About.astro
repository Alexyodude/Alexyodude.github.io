---
import timeline from '../content/timeline.json';

type Entry = {
  date: string;
  title: string;
  description: string;
};

// Timeline JSON is newest-first; reverse so it reads past → future left to right.
const entries = (timeline as Entry[]).slice().reverse();
---

<!-- mt-28 pairs with the hero's mb-28 for the mobile gap (they collapse to one
     28-unit space); my-8 takes over from md up. -->
<section class="glass px-6 py-16 max-w-3xl mx-auto mt-28 md:my-8">
  <div id="timeline-row" class="timeline-row" role="region" aria-label="Life timeline">
    <div class="timeline-content" role="list">
      <span class="timeline-track" aria-hidden="true"></span>
      <span class="timeline-progress" aria-hidden="true"></span>
      <span class="timeline-pulse" aria-hidden="true"></span>
      {entries.map((e) => (
        <div class="timeline-entry" role="listitem">
          <span class="timeline-dot"></span>
          <div class="timeline-date">{e.date}</div>
          <div class="timeline-title">{e.title}</div>
        </div>
      ))}
    </div>
  </div>

  <h2 class="mt-12 text-sm uppercase tracking-widest text-muted">About</h2>
  <p class="mt-6 text-base md:text-lg leading-relaxed">
    Grew up between <span class="text-fg">Vancouver</span>,
    <span class="text-fg">Boston</span>, and
    <span class="text-fg">Seoul</span>: elementary school in Vancouver,
    middle school in Boston, then an international high school in South Korea.
    Studied <span class="text-fg">Theoretical Physics</span> at
    <span class="text-fg">King's College London</span> (BSc and MSc). Completed military service 2024–2025.
  </p>
</section>

<style>
  .timeline-row {
    overflow-x: auto;
    cursor: grab;
    scrollbar-width: none;
    user-select: none;
    -webkit-user-select: none;
    padding-bottom: 0.5rem;
  }
  .timeline-row::-webkit-scrollbar { display: none; }
  .timeline-row.dragging { cursor: grabbing; }

  /* Inline-flex sizes to its content. All percentages on abs-positioned
     children here are relative to the FULL timeline width, not the visible
     viewport — so left:100% really does mean the right edge of the timeline. */
  .timeline-content {
    position: relative;
    display: inline-flex;
    gap: 12px;
    min-width: 100%;
  }
  .timeline-entry {
    position: relative;
    flex-shrink: 0;
    width: 144px;
    padding-top: 1.25rem;
    z-index: 3;
  }
  .timeline-dot {
    position: absolute;
    left: 50%;
    top: 8px;
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-bg);
  }
  .timeline-date {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
  }
  .timeline-title {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
  }

  /* Dim base track spans from the first to last dot center (72px = half entry width). */
  .timeline-track {
    position: absolute;
    left: 72px;
    right: 72px;
    top: 14px;
    height: 1px;
    background: var(--color-border);
    pointer-events: none;
    z-index: 1;
  }
  /* Multi-stop gradient progress — grows once to fill, then a moving shimmer
     band continuously scrolls across it so the bar reads as a live loader. */
  .timeline-progress {
    position: absolute;
    left: 72px;
    top: 14px;
    height: 2px;
    margin-top: -1px;
    width: 0;
    background:
      /* moving shimmer band (white highlight) on top */
      linear-gradient(
        90deg,
        transparent 0%,
        rgba(255,255,255,0.0) 35%,
        rgba(255,255,255,0.85) 50%,
        rgba(255,255,255,0.0) 65%,
        transparent 100%
      ) 0 0 / 200% 100% repeat-x,
      /* base rainbow gradient that itself slides for a flowing hue */
      linear-gradient(
        90deg,
        #7c3aed 0%,
        #2563eb 22%,
        #06b6d4 44%,
        #10b981 62%,
        #f59e0b 80%,
        #ef4444 100%
      ) 0 0 / 200% 100% repeat-x;
    background-blend-mode: screen, normal;
    box-shadow:
      0 0 6px rgba(99,102,241,0.55),
      0 0 14px rgba(236,72,153,0.30);
    pointer-events: none;
    z-index: 2;
    animation:
      timelineProgress 8s ease-out 1 forwards,
      timelineShimmer 2.2s linear infinite,
      timelineHueShift 6s linear infinite;
  }
  .timeline-pulse {
    position: absolute;
    top: 14px;
    left: 72px;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    margin-left: -5px;
    border-radius: 9999px;
    background: conic-gradient(from 0deg, #7c3aed, #2563eb, #06b6d4, #10b981, #f59e0b, #ef4444, #7c3aed);
    box-shadow:
      0 0 8px rgba(99,102,241,0.95),
      0 0 18px rgba(236,72,153,0.65),
      0 0 30px rgba(6,182,212,0.40);
    pointer-events: none;
    z-index: 4;
    animation:
      timelineMove 8s ease-out 1 forwards,
      timelinePulse 1.4s ease-in-out infinite,
      timelineSpin 3s linear infinite;
  }
  @keyframes timelineMove {
    0%   { left: 72px; }
    100% { left: calc(100% - 72px); }
  }
  @keyframes timelineProgress {
    0%   { width: 0; }
    100% { width: calc(100% - 144px); }
  }
  @keyframes timelinePulse {
    0%, 100% { opacity: 0.55; transform: scale(1) rotate(0deg); }
    50%      { opacity: 1;    transform: scale(1.8) rotate(180deg); }
  }
  @keyframes timelineShimmer {
    0%   { background-position: 200% 0, 0% 0; }
    100% { background-position: 0% 0, -200% 0; }
  }
  @keyframes timelineHueShift {
    0%   { filter: hue-rotate(0deg); }
    100% { filter: hue-rotate(360deg); }
  }
  @keyframes timelineSpin {
    from { background-image: conic-gradient(from   0deg, #7c3aed, #2563eb, #06b6d4, #10b981, #f59e0b, #ef4444, #7c3aed); }
    to   { background-image: conic-gradient(from 360deg, #7c3aed, #2563eb, #06b6d4, #10b981, #f59e0b, #ef4444, #7c3aed); }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-progress { animation: timelineProgress 8s ease-out 1 forwards; }
    .timeline-pulse    { animation: timelineMove 8s ease-out 1 forwards, timelinePulse 1.4s ease-in-out infinite; }
  }
</style>

<script is:inline>
  (function () {
    function init() {
      const el = document.getElementById('timeline-row');
      if (!el) return;
      // Default to the right end so the most recent entry is visible on load.
      const scrollToEnd = () => { el.scrollLeft = el.scrollWidth - el.clientWidth; };
      scrollToEnd();
      window.addEventListener('load', scrollToEnd);
      let isDown = false;
      let startX = 0;
      let startScroll = 0;
      let moved = false;
      const start = (clientX) => {
        isDown = true;
        moved = false;
        startX = clientX;
        startScroll = el.scrollLeft;
        el.classList.add('dragging');
      };
      const move = (clientX, e) => {
        if (!isDown) return;
        const dx = clientX - startX;
        if (Math.abs(dx) > 3) moved = true;
        if (e && moved) e.preventDefault();
        el.scrollLeft = startScroll - dx;
      };
      const end = () => {
        isDown = false;
        el.classList.remove('dragging');
      };
      el.addEventListener('mousedown', (e) => start(e.clientX));
      window.addEventListener('mousemove', (e) => move(e.clientX, e));
      window.addEventListener('mouseup', end);
      el.addEventListener('mouseleave', () => { if (isDown) end(); });
      el.addEventListener('touchstart', (e) => start(e.touches[0].clientX), { passive: true });
      el.addEventListener('touchmove', (e) => move(e.touches[0].clientX, e), { passive: false });
      el.addEventListener('touchend', end);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
